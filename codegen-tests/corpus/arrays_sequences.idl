// Comprehensive arrays and sequences tests

module arrays_sequences {
    // Fixed arrays
    struct FixedArrays {
        long nums[10];
        string names[5];
        double matrix[3][3];
        boolean flags[2][4][8];
    };

    // Sequences (unbounded)
    struct UnboundedSequences {
        sequence<long> int_seq;
        sequence<string> str_seq;
        sequence<double> double_seq;
        sequence<boolean> bool_seq;
    };

    // Sequences (bounded)
    struct BoundedSequences {
        sequence<long, 100> int_seq;
        sequence<string, 50> str_seq;
        sequence<double, 10> double_seq;
    };

    // Nested sequences
    typedef sequence<long> LongSeq;
    typedef sequence<string, 10> BoundedStringSeq;
    typedef sequence<LongSeq> LongSeqSeq;
    typedef sequence<BoundedStringSeq> BoundedStringSeqSeq;
    typedef sequence<LongSeq> LongSeqForTensor;
    typedef sequence<LongSeqForTensor> LongSeqSeqSeq;

    struct NestedSequences {
        LongSeqSeq matrix;
        BoundedStringSeqSeq bounded_matrix;
        LongSeqSeqSeq tensor;
    };

    // Mixed arrays and sequences
    typedef long LongArray5[5];
    typedef LongSeq LongSeqArray[10];
    typedef LongSeq LongSeq3[3];

    struct MixedCollections {
        sequence<LongArray5> array_seq;
        LongSeqArray seq_array;
        sequence<LongSeq3> mixed;
    };

    // Typedef sequences
    typedef sequence<long> IntSeq;
    typedef sequence<long, 256> BoundedIntSeq;
    typedef sequence<IntSeq> SeqOfSeq;

    struct TypedefCollections {
        IntSeq unbounded;
        BoundedIntSeq bounded;
        SeqOfSeq nested;
    };

    struct LargeCopyArrays {
        octet one_dim[128];
        octet two_dim[128][128];
        octet three_dim[128][128][128];
    };
};
