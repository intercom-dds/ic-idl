module OperationTests {
    interface KeywordOperations {
        void add();
        void and();
        void args();
        void ascending();
        void async();
        void await();
        void by();
        void descending();
        void dynamic();
        void equals();
        void file();
        void from();
        void get();
        void global();
        void group();
        void init();
        void into();
        void join();
        void let();
        void managed();
        void nameof();
        void nint();
        void not();
        void notnull();
        void nuint();
        void on();
        void or();
        void orderby();
        void partial();
        void record();
        void remove();
        void required();
        void scoped();
        void select();
        void set();
        void unmanaged();
        void value();
        void var();
        void when();
        void where();
        void with();
        void yield();
