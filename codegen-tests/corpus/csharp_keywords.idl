};

module ParameterTests {
    interface KeywordParameters {
        void testParams1(in long add, in long and, in long args);
        void testParams2(in long ascending, in long async, in long await, in long by);
        void testParams3(in long descending, in long dynamic, in long equals, in long file);
        void testParams4(in long from, in long get, in long global, in long group);
        void testParams5(in long init, in long into, in long join, in long let);
        void testParams6(in long managed, in long nameof, in long nint, in long not);
        void testParams7(in long notnull, in long nuint, in long on, in long or);
        void testParams8(in long orderby, in long partial, in long record, in long remove);
        void testParams9(in long required, in long scoped, in long select, in long set);
        void testParams10(in long unmanaged, in long value, in long var, in long when);
        void testParams11(in long where, in long with, in long yield);
    };
};

module TypeReferenceTests {
    struct UsesProblematicTypes {
        ProblematicTypes::file fileField;
        ProblematicTypes::record recordField;
        ProblematicTypes::required requiredField;
        ProblematicTypes::scoped scopedField;
    };
};

module UnionTests {
    union KeywordUnion switch (long) {
        case 1: ProblematicTypes::file fileCase;
        case 2: ProblematicTypes::record recordCase;
        case 3: ProblematicTypes::required requiredCase;
        case 4: ProblematicTypes::scoped scopedCase;
        default: long defaultCase;
    };
};

module EnumTests {
    enum KeywordEnum {
        add,
        file,
        record,
        required,
        scoped,
        value,
        var
    };
};

module CollectionTests {
    typedef sequence<ProblematicTypes::file> FileSequence;
    typedef sequence<ProblematicTypes::record> RecordSequence;
    typedef map<string, ProblematicTypes::file> FileMap;
    typedef map<string, ProblematicTypes::record> RecordMap;
};
