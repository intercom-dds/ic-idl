// Edge cases and corner cases

module edge_cases {
    // Empty struct
    struct Empty {
    };

    // Single field struct
    struct SingleField {
        long value;
    };

    // Struct with only optional fields
    struct AllOptional {
        @optional long opt1;
        @optional string opt2;
        @optional double opt3;
    };

    // Maximum nesting of sequences
    typedef sequence<long> Seq1;
    typedef sequence<Seq1> Seq2;
    typedef sequence<Seq2> Seq3;
    typedef sequence<Seq3> Seq4;

    struct DeepNesting {
        Seq4 deeply_nested;
    };

    // Union with single case
    union SingleCaseUnion switch (long) {
        case 1: long value;
    };

    // Union with only default
    union OnlyDefault switch (long) {
        default: string value;
    };

    enum MyEnum {
        ZERO,
        ONE
    };

    union OnlyDefaultEnum switch (MyEnum) {
    default:
        string value;
    };

    // Very large array bounds
    struct LargeArrays {
        long big_array[1000];
        sequence<long, 10000> big_seq;
        string<65535> max_string;
    };

    // Enum with single value
    enum SingleValue {
        ONLY_ONE
    };

    // Enum with gaps in values
    enum GappedEnum {
        FIRST = 0,
        SECOND = 10,
        THIRD = 100,
        FOURTH = 1000
    };

    // Struct with reserved keywords as field names (with underscore)
    struct ReservedNames {
        long switch_;
        long case_;
        long default_;
        long module_;
        long struct_;
    };

    // Maximum typedef chain
    typedef long T1;
    typedef T1 T2;
    typedef T2 T3;
    typedef T3 T4;
    typedef T4 T5;
    typedef T5 T6;
    typedef T6 T7;
    typedef T7 T8;

    struct MaxTypedefChain {
        T8 value;
    };

    // Struct with all array dimensions
    struct MultiDimArrays {
        long arr1[1];
        long arr2[2][2];
        long arr3[3][3][3];
        long arr4[4][4][4][4];
    };

    // Sequence of sequences with different bounds
    typedef sequence<long, 10> BSeq10;
    typedef sequence<long, 20> BSeq20;

    struct MixedBounds {
        sequence<BSeq10> unbounded_of_bounded;
        sequence<BSeq10, 5> bounded_of_bounded;
    };

    // Union with boolean discriminator (only 2 cases possible)
    union BoolDisc switch (boolean) {
        case TRUE: long true_val;
        case FALSE: long false_val;
    };

    // Octet arrays (byte arrays)
    struct OctetArrays {
        octet bytes[256];
        sequence<octet> byte_stream;
        sequence<octet, 1024> bounded_bytes;
    };

    // Wide character types
    struct WideChars {
        wchar wc;
        wstring wstr;
        wstring<100> bounded_wstr;
        sequence<wchar> wchar_seq;
    };

    // Very small sequence bound (edge case)
    struct TinyBound {
        sequence<long, 1> tiny_seq;
    };
};
