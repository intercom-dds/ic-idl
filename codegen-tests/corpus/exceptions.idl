// Exception tests

module exceptions {
    typedef string wiffle;
    typedef string<20> bounded_wiffle;

    exception SimpleException {
        long error_code;
        string message;
    };

    exception WiffleException {
        wiffle waffle;
        bounded_wiffle bounded_waffle;
        string woffle;
        string<10> bounded_woffle;
    };

    exception EmptyException {
    };

    exception ComplexException {
        long bar;
        string baz;
        string<15> bounded_baz;
        double value;
        boolean flag;
        string what;
    };

    module scope1 {
        typedef string string_in_other_scope;
        typedef string<30> bounded_string_in_other_scope;

        exception LocalException {
            long code;
            string_in_other_scope msg;
        };
    };

    module scope2 {
        exception WiffleException {
            scope1::string_in_other_scope waffle;
            scope1::bounded_string_in_other_scope bounded_waffle;
        };

        exception CrossScopeException {
            scope1::string_in_other_scope data;
            long value;
        };
    };

    exception SequenceException {
        sequence<long> error_codes;
        sequence<string> messages;
    };

    exception ArrayException {
        long codes[5];
        string messages[3];
    };

    struct ErrorData {
        long code;
        string description;
    };

    exception StructException {
        ErrorData error;
        string _context;
    };

    interface ExceptionInterface {
        exception NotFound {
            string key;
        };

        exception InvalidInput {
            string message;
            long position;
        };

        long find(in string key) raises (NotFound);
        void validate(in string input) raises (InvalidInput);
    };
};
