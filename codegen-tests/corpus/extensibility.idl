// Extensibility modes and @ID annotation

module extensibility {
    @final
    struct FinalStruct {
        @key long id_;
        string name;
        double value;
    };

    @appendable
    struct ExtensibleStruct {
        @key long id_;
        string name;
        double value;
    };

    @mutable
    struct MutableStruct {
        @key @ID(0) long id_;
        @ID(1) string name;
        @ID(2) double value;
    };

    @final
    struct FinalWithKey {
        @key short key_field;
        long value_field;
    };

    @appendable
    struct ExtensibleWithOptional {
        @key short key_field;
        @optional long optional_field;
        string required_field;
    };

    @mutable
    struct MutableWithIds {
        @key @ID(10) short key_field;
        @ID(20) long value_field;
        @ID(30) string name_field;
    };

    @mutable
    struct MutableSparse {
        @key @ID(0) long id_;
        @ID(100) string name;
        @ID(1000) double value;
    };

    @final
    struct FinalNested {
        @key long id_;
        FinalStruct nested;
    };

    @appendable
    struct ExtensibleNested {
        @key long id_;
        ExtensibleStruct nested;
    };

    @mutable
    struct MutableNested {
        @key @ID(0) long id_;
        @ID(1) MutableStruct nested;
    };

    @mutable
    struct MutableWithSequences {
        @key @ID(0) long id_;
        @ID(1) sequence<long> numbers;
        @ID(2) sequence<string> names;
    };

    @final struct FinalLowercase {
        @key long id_;
        string data;
    };

    @final
    struct FinalComplex {
        @key string<128> key_str;
        sequence<octet, 16> data;
        long value;
    };

    @appendable
    struct ExtensibleComplex {
        @key string<128> key_str;
        sequence<octet, 16> data;
        long value;
    };

    @mutable
    struct MutableComplex {
        @key @ID(0) string<128> key_str;
        @ID(1) sequence<octet, 16> data;
        @ID(2) long value;
    };
};
