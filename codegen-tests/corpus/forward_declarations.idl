// Forward declarations and circular references

module forward_declarations {
    // Simple forward declaration
    struct ForwardDeclared;

    struct UsesForward {
        sequence<ForwardDeclared> fwd;
    };

    struct ForwardDeclared {
        long value;
    };

    // Mutual references (circular)
    struct NodeA;
    struct NodeB;

    struct NodeA {
        sequence<NodeB> b_ref;
        long a_value;
    };

    struct NodeB {
        NodeA a_ref;
        long b_value;
    };

    // Self-referential struct (requires sequence)
    struct TreeNode {
        long value;
        sequence<TreeNode> children;
    };

    // Forward with typedef
    struct FwdType;
    typedef FwdType MyFwdType;

    struct UsesFwdTypedef {
        sequence<MyFwdType> ref;
    };

    struct FwdType {
        long data;
    };

    // Complex forward scenario
    struct ComplexFwd;

    struct UsesComplexFwd {
        sequence<ComplexFwd> fwd_seq;
    };

    struct ComplexFwd {
        long value;
        UsesComplexFwd back_ref;
    };

    // Forward declaration in union
    struct UnionMember;

    union ForwardUnion switch (long) {
    case 1:
        sequence<UnionMember> member;
    case 2:
        long value;
    };

    struct UnionMember {
        long data;
    };

    // Linked list pattern
    struct ListNode {
        long data;
        sequence<ListNode> next;
    };

    // Binary tree pattern
    struct BinaryNode {
        long value;
        sequence<BinaryNode, 2> children;
    };
};
