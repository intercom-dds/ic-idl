    union AutoIdSequential switch(octet) {
    case 0:
        string member1;
    case 1:
        string member2;
    case 9:
        string member3;
    };

    @autoid(HASH)
    union AutoIdHash switch(octet) {
    case 0:
        string member1;
    case 1:
        string member2;
    case 9:
        string member3;
    };

    @autoid(HASH)
    struct AutoIdWithHashId {
        string color;
        @hashid("shapesize") long size;
    };
