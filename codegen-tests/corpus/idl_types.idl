#ifndef IDLTYPES_IDL
#define IDLTYPES_IDL

module IdlTypes
{
   struct NoKey
   {
     long value;
   };

   struct ImplicitKey
   {
      @key NoKey keyValue;
   };

   struct PartialKey
   {
     @key long key;
     long value;
   };

   struct ExplicitKey
   {
      @key PartialKey keyValue;
   };

   struct NothingHere {};

   struct EmptyMember
   {
      NothingHere value;
   };

   // Test that a struct inside an interface does not generate invalid code
   module qux {
     interface quux {
       struct zork {
         long a;
       };
     };
   };

   // create aliases for the IDL 'basic' types.
   typedef string             DdsString;
   typedef string<12>         DdsString12;
   typedef wstring            DdsWString;
   typedef wstring<12>        DdsWString12;

   typedef string             a_second_DdsString;
   typedef string<12>         a_second_DdsString12;
   typedef wstring            a_second_DdsWString;
   typedef wstring<12>        a_second_DdsWString12;

   struct Primitives
   {
      @key short          ss;
      unsigned short      us;
      long                sl;
      unsigned long       ul;
      long long           sll;
      unsigned long long  ull;
      float               f;

      double              d;
      //long double         ld;  // long double is not supported by intercom dds
      char                c;
      boolean             b;
      wchar               wc;
      octet               o;
   };

   typedef long                  LongA4[4];
   typedef sequence<short>       ShortSeq;
   typedef sequence<short,5>     ShortSeq5;
   typedef map<short, string>    ShortStringMap;
   typedef map<short, string,5>  ShortStringMap5;

   typedef long                  a_second_LongA4[4];
   typedef sequence<short>       a_second_ShortSeq;
   typedef sequence<short,5>     a_second_ShortSeq5;
   typedef map<short, string>    a_second_ShortStringMap;
   typedef map<short, string,5>  a_second_ShortStringMap5;


   @Extensibility(MUTABLE_EXTENSIBILITY)
   struct ArrayTypes
   {
      @ID(1)  string                str;
      @ID(2)  wstring               wstr;
      @ID(3)  string<12>            str12;
      @ID(4)  wstring<12>           wstr12;
      @ID(5)  LongA4                longA4;
      @ID(6)  ShortSeq              sSeq;
      @ID(7)  ShortSeq5             sSeq5;
      @ID(8)  ShortStringMap        sMap;
      @ID(9)  ShortStringMap5       sMap5;
      @ID(10) ShortSeq5             empty_sSeq5;
   };

   @nested
   struct Other
   {
      // we expect these two values to be swapped in the transfer test
      @optional long foo;
      @optional long bar;
   };

   typedef LongA4 LongA4A4[4];


   @nested
   struct MoreArrayTypes
   {
      @ID(10) long                  lArray[10];
      @ID(11) DdsString             dds_str;
      @ID(12) DdsString12           dds_str12;
      @ID(13) DdsWString            dds_wstr;
      @ID(14) DdsWString12          dds_wstr12;
      @ID(15) long l2DArray[10][10];
      @ID(16) LongA4A4 lA4A4;
   };

   enum  MyEnum
   {
      MyEnum_e0 = 0,
      MyEnum_e_invalid = -1,
      MyEnum_e1 = 1,
      MyEnum_e2
   };

   struct MyEnumStruct
   {
      MyEnum value;
   };

   typedef MyEnumStruct MyDerivedEnumStruct;

   struct MyChildEnumStruct : MyEnumStruct
   {
      long newMember;
   };

   struct DerivedStructMemberStruct
   {
      MyDerivedEnumStruct MyDerivedStructMember;
      MyChildEnumStruct MyChildStructMember;
   };

   @Extensibility(FINAL_EXTENSIBILITY)
   struct MyString5
   {
      string<5> value;
   };

   typedef MyString5 MyString5Alias;

   struct MyMap5
   {
      ShortStringMap5 value;
   };

#ifndef IDLTYPES_SKIP_BITSET
   @BitSet @BitBound(7)
   enum MyBitset
   {
      MY_BITSET_FLAG_1,
      MY_BITSET_FLAG_2,
      @Value(5)
      MY_BITSET_FLAG_3,
      MY_BITSET_FLAG_4
   };

   struct MyBitsetStruct
   {
      MyBitset value;
   };
#endif

   /// Union
   union MyUnion switch (short) //!< This is a union
   {
      case 3:
         @optional sequence< long > sequenceType;
      case 1:
         /// This is the long type
         long longType;
      case 4: //!< This is case label 4
         @optional long optionalLongType; //!< This is the optional long type
      case 2:
         boolean boolType;
      case 133:
          null;
      case 134:
          @optional string optionalString;
      default:
         @optional octet octetType;
   };

   union UnionWithExternalMember switch (boolean)
   {
      case true:
         @external boolean really_true;
      default:
         null;
   };

   @bit_bound(2)
   enum MyBoolean { FalseValue, TrueValue, @default_literal MaybeValue };

   struct MyBooleanStruct
   {
      MyBoolean b1;
      MyBoolean b2;
      MyBoolean b3;
      boolean arr[4];
   };

   union NoDefault switch(MyBoolean)
   {
      case MaybeValue:
      case TrueValue:
         string value;
   };

   struct TrickyAlignment
   {
      @non_serialized long notHere;
      boolean myBool;
      double myDouble;
      MyBoolean myOtherBool;
      MyBoolean myOtherBoolArray[2];
      @optional double optionalDouble;
      long long myLongLong;
      boolean anotherBool;
   };

   struct TrickyAlignmentChild : TrickyAlignment
   {
      MyBoolean myThirdBool;
   };

   struct MyUnionStruct
   {
      MyUnion  value;
   };

   typedef MyUnionStruct MyDerivedUnionStruct;

   struct MyChildUnionStruct : MyUnionStruct
   {
      long newMember;
   };

   module child_package
   {
      typedef long                  array_in_child[4];
      typedef sequence<short>       sequence_in_child;
      typedef sequence<short,5>     bounded_sequence_in_child;
      typedef map<short, string>    map_in_child;
      typedef map<short, string,5>  bounded_map_in_child;

      struct foobar
      {
         @Optional child_package::array_in_child foo;
         @Optional child_package::sequence_in_child bar;
         @Optional child_package::bounded_sequence_in_child baz;
         @Optional child_package::map_in_child qux;
         @Optional child_package::bounded_map_in_child quux;
      };
   };

   struct MyOptionalMemberStruct
   {
      @Optional string<5> anonymousBoundedString;
      @Optional string unboundedString;
      @Optional DdsString12 boundedString;
      @Optional LongA4 arrayType;
      @Optional sequence<short> anonymousSequence;
      @Optional ShortSeq sequenceType;
      @Optional sequence<short, 5> anonymousBoundedSequence;
      @Optional ShortSeq5 boundedSequenceType;
      // TODO: @Optional sequence<string<5> > anonymousSequenceofAnonymousBoundedString;
   };


   typedef long no_range;

   const long foo_min=-7;

   @Range(min=foo_min, max=13)
   @Default(value=11)
   typedef long foo;

   @Range(min=-1.0, max=6.2831853070)
   @Default(value=3.1415926535)
   typedef float bar;

   @Min(value=0.0)
   @Max(3.1415926535)
   @Default(value=3.1415926535/2.0)
   typedef double baz;


   @Range(min='a', max='z')
   @Default(value='o')
   typedef char lower_case;

   enum quux
   { quux_a, quux_b, quux_c, quux_d, quux_e, quux_f };


   const string wubble = "wubble?";
   @Default(value=wubble)
   typedef string quuz;
   const quuz wibble = "wibble?";


   const foo XII = 12;
   const bar I_LVI = 1.56;

   // this constant now fails (as it should) in Ada, due to implementation of Min and Max annotations
   const baz II_XXII = -2.22;

   const lower_case D = 'd';
   const quux E = quux_e;

   const string icanhazcaek = "icanhazcaek?";

   struct Ranged_And_Defaults
   {
      @Default(value=1337) long long1;
      @Default(value=-420) long long2;
      long long3;

      @range(min=10, max=20) @default(17) long long4;


      @Default(value=666.666) float float1;
      @Default(value=-0.5) float float2;
      float float4;

      @Default(value=299792458.0) double double1;
      @Default(value=-616.616) double double2;
      double double4;

      @Default(value=42) octet octet1;
      octet octet2;

      @Default(value='y') char char1;
      char char2;

      @Default(value='n') lower_case lower_case1;
      @Default(value=D) lower_case lower_case2;
      lower_case lower_case3;
      @range(min='s', max='t') @default(value='s') lower_case lower_case4;

      @Default(value=13) foo foo1;
      @Default(value=XII) foo foo2;
      foo foo3;
      foo foo4[4];

      @Default(value=true) boolean boo1;
      boolean boo2;

      @Default(value=0.17) bar bar1;
      @Default(value=-0.7) bar bar2;
      @Default(value=I_LVI) bar bar3;
      bar bar4;

      @Default(value=0.42) baz baz1;
      @Default(value=-42.0) baz baz2;
      @Default(value=II_XXII) baz baz3;
      baz baz4;

      @Default(value=quux_b) quux quux1;
      @Default(value=E) quux quux2;
      quux quux3;
      quux quux4;


      // string literals in annotations doesn't work in cidl.
      // However, applying a const string works.
      // @Default(value="cake is good!") string cake;
      @Default(value=icanhazcaek) string caek;

      @Default(value=wibble) quuz quuz1;
      // string literals in annotations doesn't work in cidl.
      // However, applying a const string works.
      @Default(value="wobble") quuz quuz2;
      quuz quuz3;

   };


   module toto {

     @min(value=-100)
     typedef long titi;

     // Use titi directly without redefining bounds
     typedef titi tata;

     struct tutu {
       tata wombat;
     };


     @range(min=-42,max=42)
     typedef long wibble;

     // Use wibble directly without redefining bounds
     typedef wibble wabble;

     struct wobble {
       wabble wombat;
     };


     @min(value=-100)
     @max(value=100)
     typedef long fiffle;

     // Use fiffle directly without redefining bounds
     typedef fiffle faffle;

     struct foffle {
       faffle wombat;
     };

   };


   module xtypes {
      @final
      struct MyStructFinal {
         @id(1) @must_understand long x;
         @id(2) long long y;
         @id(5) @optional short z;
         @id(7) string<2> str;
      };
      @appendable
      struct MyStructAppendable {
         @id(1) @must_understand long x;
         @id(2) long long y;
         @id(5) @optional short z;
         @id(7) string<2> str;
      };
      @mutable
      struct MyStructMutable {
         @id(1) @must_understand long x;
         @id(2) long long y;
         @id(5) @optional short z;
         @id(7) string<2> str;
      };
      @mutable
      struct MyStructMutableReordered {
         @id(7) string<2> str;
         @id(1) @must_understand long x;
         @id(5) @optional short z;
         @id(2) long long y;
      };
      @appendable
      struct MyStructAppendableExtended {
         @id(1) @must_understand long x;
         @id(2) long long y;
         @id(5) @optional short z;
         @id(7) string<2> str;
         @id(8) string<2> str2;
      };

   };

   struct MyStruct {};

   @nested
   struct MyNestedStruct {};

   bitmask MyBitmask {
      FLAG_1
   };

   exception MyException {};

   valuetype MyValuetype  {
       boolean my_function();
   };

