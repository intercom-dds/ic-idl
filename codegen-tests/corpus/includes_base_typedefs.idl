#pragma once

#include "base_typedefs/base_typedefs.idl"

module base_typedefs {
    struct DerivedStruct : StructAlias {
        long derived_value;
    };

    struct DerivedFwdStruct : FwdStructAlias {
        long derived_fwd_value;
    };

    interface DerivedInterface : InterfaceAlias {
        void derived_op();
    };

    valuetype DerivedValue : ValueAlias {
        public long derived_data;
    };

    valuetype SupportingValue supports InterfaceAlias {
        public long supporting_data;
    };

    struct UsesAliasMember {
        StructAlias plain;
        FwdStructAlias deferred;
        sequence<FwdStructAlias> deferred_seq;
    };
};
