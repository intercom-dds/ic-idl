// Comprehensive struct inheritance tests

module inheritance_tests {
    // Simple inheritance
    struct Base {
        long id_;
        string name;
    };

    struct Derived : Base {
        double value;
    };

    // Multi-level inheritance
    struct Level1 {
        long l1;
    };

    struct Level2 : Level1 {
        long l2;
    };

    struct Level3 : Level2 {
        long l3;
    };

    struct Level4 : Level3 {
        long l4;
    };

    // Diamond problem (not allowed but testing detection)
    struct Animal {
        string species;
    };

    struct Mammal : Animal {
        boolean warm_blooded;
    };

    struct Bird : Animal {
        boolean can_fly;
    };

    // Using inherited types
    struct Container {
        Derived derived_obj;
        Level4 deep_obj;
    };

    // Empty base
    struct EmptyBase {
    };

    struct DerivedFromEmpty : EmptyBase {
        long value;
    };

    // Inheritance with same field names (allowed in different levels)
    struct Parent {
        long value;
        string name;
    };

    struct Child : Parent {
        double child_value;
        long child_id;
    };

    // Struct with annotations and inheritance
    @appendable
    struct AnnotatedBase {
        long base_val;
    };

    @mutable
    struct AnnotatedDerived : AnnotatedBase {
        string derived_val;
    };
};
