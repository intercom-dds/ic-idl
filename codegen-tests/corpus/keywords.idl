    // also try some other constructs, using "while", "if", "else" and "for" as
    // these are keywords in most languages, but not in IDL
    module foo {
        typedef short else;
        typedef sequence<else> if;
      typedef sequence<else, 10> for;
    };

    module bar {
      typedef short else;
      typedef map<else, short> if;
      typedef map<short, else, 10> for;
    };

    module baz {
      typedef short else;
      typedef else if[3][3];
    };

    module qux {
      typedef string if;
      typedef string<10> for;
    };

    module if {
      typedef string while;

      exception else {
         string for;
      };

      @DDSService
      interface for
      {
         attribute while do setraises (else);
         while if(inout while do) raises(else);
      };
    };
};
