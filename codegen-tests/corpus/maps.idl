// Map types tests

module maps {
    // Basic maps
    typedef map<long, string> LongStringMap;
    typedef map<string, long> StringLongMap;
    typedef map<long, long> LongLongMap;

    // Bounded maps
    typedef map<long, string, 10> BoundedLongStringMap;
    typedef map<string, double, 100> BoundedStringDoubleMap;

    // Maps with various key types
    typedef map<short, string> ShortKeyMap;
    typedef map<long long, string> LongLongKeyMap;
    typedef map<char, string> CharKeyMap;
    typedef map<boolean, string> BoolKeyMap;
    typedef map<octet, string> OctetKeyMap;

    // Maps with various value types
    typedef map<string, short> ShortValueMap;
    typedef map<string, double> DoubleValueMap;
    typedef map<string, boolean> BoolValueMap;
    typedef map<string, sequence<long>> SeqValueMap;

    // Map of maps
    typedef map<string, string> InnerMap;
    typedef map<long, InnerMap> MapOfMaps;
    typedef map<string, long> StringLongMapForNested;
    typedef map<string, StringLongMapForNested> NestedMaps;

    // Maps with bounded strings
    typedef string<32> BoundedString32;
    typedef string<256> BoundedString256;
    typedef map<BoundedString32, BoundedString256> BoundedStringMap;

    // Struct with maps
    struct MapContainer {
        LongStringMap basic_map;
        BoundedLongStringMap bounded_map;
        MapOfMaps nested_map;
        BoolKeyMap bool_keyed_map;
    };

    // Sequence of maps
    struct MapSequence {
        sequence<LongStringMap> map_seq;
    };

    // Map in union
    union MapUnion switch (long) {
        case 1: LongStringMap str_map;
        case 2: LongLongMap num_map;
    };

    // Complex map keys and values
    struct ComplexKey {
        @key long id_;
        @key string name;
    };

    struct ComplexValue {
        double value;
        sequence<long> data;
    };

    typedef map<ComplexKey, ComplexValue> ComplexMap;
    typedef map<long, string, 1> OneMap;
};
