// Comprehensive module and scoping tests

// Top-level module
module top_level {
    struct TopStruct {
        long value;
    };

    // Nested module
    module nested {
        struct NestedStruct {
            long nested_value;
        };

        // Double nested
        module deep_nested {
            struct DeepStruct {
                long deep_value;
            };
        };
    };
};

// Multiple modules at same level
module module_a {
    struct TypeA {
        long a;
    };

    typedef long LongA;
};

module module_b {
    struct TypeB {
        long b;
    };

    typedef string StringB;
};

// Cross-module references
module module_c {
    struct TypeC {
        module_a::TypeA ref_a;
        module_b::TypeB ref_b;
        module_a::LongA typedef_ref;
    };
};

// Reopening modules
module module_a {
    struct AnotherTypeA {
        long another_a;
    };
};

// Scoped names in different contexts
module scoping {
    struct Outer {
        long value;
    };

    struct Container {
        Outer outer_ref;
        scoping::Outer scoped_ref;
    };

    module inner {
        struct InnerStruct {
            scoping::Outer parent_ref;
        };
    };
};

// Empty module
module empty_module {
};
