// Nested key tests

module nested_keys {
    struct NoKey {
        long value;
    };

    struct ImplicitKey {
        @key NoKey key_value;
    };

    struct PartialKey {
        @key long key;
        long value;
    };

    struct ExplicitKey {
        @key PartialKey key_value;
    };

    struct SimpleKey {
        @key long id_;
        string data;
    };

    struct NestedSimpleKey {
        @key SimpleKey key;
        double value;
    };

    struct DoubleNestedKey {
        @key NestedSimpleKey key;
        string description;
    };

    struct MultipleKeys {
        @key long id_;
        @key string name;
        double value;
    };

    struct NestedMultipleKeys {
        @key MultipleKeys keys;
        boolean flag;
    };

    struct CompositeKey {
        @key long id1;
        @key NoKey nested1;
        @key PartialKey nested2;
        string data;
    };

    struct MixedKeys {
        @key long simple_key;
        @key SimpleKey struct_key;
        long non_key_value;
    };
};
