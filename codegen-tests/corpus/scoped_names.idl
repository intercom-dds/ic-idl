// Scoped name resolution and global scope

// Global typedef
typedef string GlobalType;

module scoped_names {
    // Local typedef with same name
    typedef long GlobalType;

    struct LocalScope {
        GlobalType local_ref;
        ::GlobalType global_ref;
    };

    module nested {
        // Another typedef with same name
        typedef double GlobalType;

        struct NestedScope {
            GlobalType nested_ref;
            scoped_names::GlobalType parent_ref;
            ::GlobalType global_ref;
        };

        module deep {
            typedef boolean GlobalType;

            struct DeepScope {
                GlobalType deep_ref;
                nested::GlobalType parent_ref;
                scoped_names::GlobalType grandparent_ref;
                ::GlobalType global_ref;
            };
        };
    };

    // Using :: prefix for global scope
    struct GlobalReference {
        ::GlobalType definitely_global;
    };

    // Fully qualified names
    struct FullyQualified {
        scoped_names::nested::GlobalType nested_type;
        scoped_names::nested::deep::GlobalType deep_type;
    };
};

// Another module with same name as nested
module nested {
    typedef char MyChar;

    struct NotRelated {
        MyChar c;
    };
};

// Using both nested modules
module ambiguous {
    struct UsesNested {
        scoped_names::nested::GlobalType from_scoped;
        ::nested::MyChar from_global_nested;
    };
};

// Enum with same name in different scopes
enum Status { OK, ERROR };

module status_test {
    enum Status { IDLE, BUSY };

    struct StatusContainer {
        Status local_status;
        ::Status global_status;
    };
};

// Constant with same name
const long MAX = 100;

module constants {
    const long MAX = 200;

    struct WithConstants {
        long local_array[MAX];
        long global_array[::MAX];
    };
};
