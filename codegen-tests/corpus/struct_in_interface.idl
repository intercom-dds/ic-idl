// Struct defined inside interface

module struct_in_interface {
    // Struct inside interface
    interface Container {
        struct InnerStruct {
            long value;
            string name;
        };

        InnerStruct get_data();
        void set_data(in InnerStruct data);
    };

    // Multiple structs in interface
    interface MultiStruct {
        struct Data {
            long id_;
        };

        struct Config {
            string mode;
            long timeout;
        };

        Data get_data();
        Config get_config();
    };

    // Nested modules and interfaces
    module nested {
        interface NestedInterface {
            struct NestedStruct {
                double value;
            };

            NestedStruct process();
        };
    };

    // Using interface-scoped struct outside
    struct UsesInterfaceStruct {
        Container::InnerStruct inner;
        MultiStruct::Data data;
    };

    // Enum in interface
    interface WithEnum {
        enum Status {
            OK,
            ERROR,
            PENDING
        };

        Status get_status();
    };

    // Union in interface
    interface WithUnion {
        union Result switch (long) {
            case 0: long error_code;
            case 1: string success_msg;
        };

        Result execute();
    };

    // Typedef in interface
    interface WithTypedef {
        typedef sequence<long> LongSeq;

        LongSeq get_numbers();
    };

    // Constant in interface
    interface WithConst {
        const long MAX_SIZE = 1000;

        struct BoundedData {
            long data[MAX_SIZE];
        };
    };

    // Exception in interface
    interface WithException {
        exception NotFound {
            string message;
        };

        long find(in string key) raises (NotFound);
    };

    // Complex interface with all types
    interface Complex {
        struct Data {
            long id_;
        };

        enum Mode {
            READ,
            WRITE
        };

        union Value switch (Mode) {
            case READ: Data read_data;
            case WRITE: string write_data;
        };

        typedef sequence<Data> MyDataSeq;

        const long VERSION = 1;

        exception InvalidMode {
            Mode mode;
        };

        Value process(in Mode m) raises (InvalidMode);
    };
};
