// Test sequences, arrays, and bounded strings
module TestCollections {
    typedef sequence<long> IntSeq;
    typedef sequence<long, 10> BoundedIntSeq;
    typedef string<256> BoundedString;

    struct Container {
        sequence<long> numbers;
        sequence<string, 5> names;
        string<100> description;
    };
};

// Test multi-level inheritance
module TestInheritance {
    struct Base {
        long id_;
    };

    struct Derived : Base {
        string name;
    };

    struct MoreDerived : Derived {
        double value;
    };
};

// Test union with enum discriminator
module TestUnionEnum {
    enum Status {
        IDLE,
        RUNNING,
        STOPPED
    };

    union StatusData switch (Status) {
        case IDLE: long idle_time;
        case RUNNING: string process_name;
        case STOPPED: long exit_code;
    };
};

// Test valuetype with inheritance
module TestValuetype {
    valuetype BaseValue {
        public long id_;
    };

    valuetype DerivedValue : BaseValue {
        public string name;
    };
};

// Test cross-module references
module ModuleA {
    struct TypeA {
        long value;
    };
};

module ModuleB {
    struct TypeB {
        ModuleA::TypeA ref_to_a;
        long own_value;
    };
};
