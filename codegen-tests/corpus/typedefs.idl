// Comprehensive typedef tests

module typedef_tests {
    // Basic typedefs
    typedef long LongType;
    typedef string StringType;
    typedef double DoubleType;

    // Array typedefs
    typedef long IntArray[10];
    typedef string NameArray[5];
    typedef double Matrix[3][3];

    // Sequence typedefs
    typedef sequence<long> IntSeq;
    typedef sequence<string> StrSeq;
    typedef sequence<long, 100> BoundedIntSeq;

    // Bounded string typedef
    typedef string<256> BoundedString;

    // Typedef chains
    typedef long MyLong;
    typedef MyLong MyMyLong;
    typedef MyMyLong DeepLong;

    // Struct using typedefs
    struct TypedefUser {
        LongType my_long;
        StringType my_string;
        IntArray int_arr;
        IntSeq int_seq;
        BoundedString bounded_str;
        DeepLong deep;
    };

    // Typedef of struct
    struct Point {
        double x;
        double y;
    };
    typedef Point Point2D;
    @ext::newtype typedef Point WrappedPoint;
    typedef Point PointArray[10];
    typedef sequence<Point> PointSeq;

    // Typedef of enum
    enum Status {
        OK,
        ERROR,
        PENDING
    };
    typedef Status MyStatus;

    // Rust newtype typedefs
    @ext::newtype typedef string MyString;
    @ext::newtype typedef long MyInteger;
    const MyInteger MyIntegerConstant = 123;

    // Complex typedef
    typedef long LongArray5[5];
    typedef sequence<LongArray5> LongArraySeq;
    typedef sequence<LongArraySeq, 10> ComplexType;

    struct ComplexUser {
        ComplexType complex;
    };

    // Forward declaration with typedef
    struct ForwardRef;
    typedef ForwardRef FwdRef;

    struct ForwardRef {
        long value;
    };

    struct UsesFwd {
        FwdRef ref;
    };
};
