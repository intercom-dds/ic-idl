module union_tests {
    // Simple union with integer discriminator
    union SimpleUnion switch (long) {
        case 1: long int_val;
        case 2: string str_val;
        case 3: double float_val;
        default: boolean default_val;
    };

    // Enum discriminator
    enum Color {
        RED,
        GREEN,
        BLUE
    };

    union ColorData switch (Color) {
        case RED: long red_value;
        case GREEN: string green_name;
        case BLUE: double blue_intensity;
    };

    // Boolean discriminator
    union BoolUnion switch (boolean) {
        case TRUE: long true_val;
        case FALSE: string false_val;
    };

    // Nested unions
    union InnerUnion switch (short) {
        case 1: long value;
        case 2: string name;
    };

    union OuterUnion switch (long) {
        case 1: InnerUnion nested;
        case 2: long simple;
    };

    // Union with multiple cases for same member
    union MultiCaseUnion switch (long) {
        case 1:
        case 2:
        case 3: long small_val;
        case 10:
        case 20: string text_val;
        default: boolean flag;
    };

    // Union with @key discriminator
    union KeyDiscriminatorUnion switch (@key long) {
        case 1:
        case 2:
            string string_value;
        default:
            double double_value;
    };

    const int32 MY_UNION_CASE1 = 123;
    const int32 MY_UNION_CASE2 = 456;

    // Union with numeric constants as case labels
    union NumericConstUnion switch(int32) {
    case 0:
        string abc;
    case MY_UNION_CASE1:
        string def;
    case MY_UNION_CASE2:
        string ghi;
    };
};
