// Validation constraint vocabulary: all eight @ext:: validation annotations
// applied to typical shapes.

module validation_annotations {

    @ext::pattern_ecma262("^[A-Z][A-Za-z0-9]*$")
    @ext::pattern_python("^[A-Z][A-Za-z0-9]*$")
    @ext::pattern_xsd("[A-Z][A-Za-z0-9]*")
    typedef string Identifier;

    @ext::min_length(3)
    @ext::max_length(24)
    typedef string Name;

    struct ExtDataConstraints {
        @ext::exclusive_minimum(1)
        @ext::exclusive_maximum(100)
        long temperature;

        @range(min = 10, max = 100)
        long bounded;

        @ext::min_length(1)
        string code;

        @ext::min_items(2)
        sequence<unsigned short, 16> readings;

        @ext::pattern_ecma262("^[0-9a-fA-F]+$")
        string checksum;

        Identifier symbol;
        Name label;
    };
};
