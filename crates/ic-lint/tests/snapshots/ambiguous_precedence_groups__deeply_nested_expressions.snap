! ambiguous-precedence: operator `|` has lower precedence than `^`
  @ test.idl:3:22

 2 │ const long test1 = 1 | (2 & (3 ^ (4 + 5)));
 3 │ const long test2 = 1 | 2 & 3 ^ 4 + 5;
   │                      ˆ ˆˆˆˆˆˆˆˆˆˆˆˆˆ than this expression
   │                      └─ this operator has lower precedence
 4 │ const long test3 = ((((1 | 2) & 3) ^ 4) + 5);
 5 │ const long test4 = 1 | ((2 & 3) ^ (4 + 5));

  ? add parentheses to clarify the intended order of operations

! ambiguous-precedence: operator `^` has lower precedence than `&`
