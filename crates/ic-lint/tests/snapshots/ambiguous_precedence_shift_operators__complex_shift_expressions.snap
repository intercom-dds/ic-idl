! ambiguous-precedence: operator `&` has lower precedence than `>>`
  @ test.idl:5:36

 3 │ const long WORD_MASK = (1 << BITS_PER_WORD) - 1;
 4 │ 
 5 │ const long test1 = value >> offset & mask;
   │                    ˆˆˆˆˆˆˆˆˆˆˆˆˆˆˆ ˆ this operator has lower precedence
   │                    └─ than this expression
 6 │ const long test2 = (value >> offset) & mask;
 7 │ const long test3 = value & mask << offset;

  ? add parentheses to clarify the intended order of operations

