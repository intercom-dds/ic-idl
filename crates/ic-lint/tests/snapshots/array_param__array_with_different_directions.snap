! array-param: using arrays as parameters in prototypes is not standard
  @ test.idl:3:40

 2 │ interface Buffer {
 3 │     void fill_buffer(out octet buffer[1024]);
   │                                ˆˆˆˆˆˆ this parameter is an array
 4 │     void process_buffer(inout octet buffer[512]);
 5 │ };

  * standard IDL does not permit arrays as parameters

