! complex-lit: complex literals are non-standard
  @ test.idl:2:32

 2 │ const long PRIMES[5] = { 2, 3, 5, 7, 11 };
   │            ˆˆˆˆˆˆ      ˆˆˆˆˆˆˆˆˆˆˆˆˆˆˆˆˆˆ complex constants are non-standard
   │            └─ const defined here
 3 │ const double MATRIX[2][2] = { {1.0, 0.0}, {0.0, 1.0} };

  * only literals of trivial types are allowed in standard IDL

! complex-lit: complex literals are non-standard
