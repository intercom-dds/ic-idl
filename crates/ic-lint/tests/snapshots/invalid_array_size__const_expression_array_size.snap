! invalid-array-size: array size 8000000 bytes exceeds reasonable limit of 16384 bytes (2000000 elements × 4 bytes each)
  @ test.idl:5:16

 3 │ const long TWO = 2;
 4 │ struct ConstArrays {
 5 │     long large[MILLION * TWO];  // 2 million
   │                ˆˆˆˆˆˆˆˆˆˆˆˆˆ very large array
 6 │     long small[MILLION / 10];   // 100k, should be fine
 7 │ };

