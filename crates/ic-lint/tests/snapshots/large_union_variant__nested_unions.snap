! large-union-variant: union variant `large` is 512 bytes, which is significantly larger than the average of other variants (1 bytes)
  @ test.idl:4:22

 2 │ union InnerUnion switch (boolean) {
 3 │     case TRUE: char small;
   │                     ˆˆˆˆˆ 1 bytes
 4 │     case FALSE: char large[512];
   │                      ˆˆˆˆˆ large variant (512 bytes)
 5 │ };

  * consider annotating large variants with `@shared` to heap allocate them

! large-union-variant: union variant `nested` is 513 bytes, which is significantly larger than the average of other variants (1 bytes)
  @ test.idl:8:24

  7 │ union OuterUnion switch (long) {
  8 │     case 1: InnerUnion nested;  // Contains large variant
    │                        ˆˆˆˆˆˆ large variant (513 bytes)
  9 │     case 2: char tiny;
    │                  ˆˆˆˆ 1 bytes
 10 │ };

  * consider annotating large variants with `@shared` to heap allocate them
