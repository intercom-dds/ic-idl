warning[lowercase-bool]: lowercase boolean literals are non-standard
   ┌ test.idl:2:31
   │
 2 │         const boolean EXPR1 = true;
   ·                               ^^^^ lowercase boolean literal
 3 │         const boolean EXPR2 = false;
 4 │         const boolean EXPR3 = True;
   └──
 help: use `TRUE` instead

warning[lowercase-bool]: lowercase boolean literals are non-standard
   ┌ test.idl:3:31
   │
 2 │         const boolean EXPR1 = true;
 3 │         const boolean EXPR2 = false;
   ·                               ^^^^^ lowercase boolean literal
 4 │         const boolean EXPR3 = True;
