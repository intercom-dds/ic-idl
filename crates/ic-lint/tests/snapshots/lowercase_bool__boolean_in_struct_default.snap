! complex-lit: complex literals are non-standard
  @ test.idl:7:39

 5 │     boolean strict;
 6 │ };
 7 │ const Config DEFAULT_CONFIG = {true, false, TRUE};
   │              ˆˆˆˆˆˆˆˆˆˆˆˆˆˆ   ˆˆˆˆˆˆˆˆˆˆˆˆˆˆˆˆˆˆˆ complex constants are non-standard
   │              └─ const defined here

  * only literals of trivial types are allowed in standard IDL

! lowercase-bool: lowercase boolean literals are non-standard
  @ test.idl:7:40

 5 │     boolean strict;
 6 │ };
 7 │ const Config DEFAULT_CONFIG = {true, false, TRUE};
   │                                ˆˆˆˆ lowercase boolean literal

  ? use `TRUE` instead

