! lowercase-bool: lowercase boolean literals are non-standard
  @ test.idl:2:40

 2 │ const boolean LOWERCASE_TRUE = true;
   │                                ˆˆˆˆ lowercase boolean literal
 3 │ const boolean LOWERCASE_FALSE = false;

  ? use `TRUE` instead

