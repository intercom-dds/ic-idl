! scoped-lit: scoped enums are non-standard
  @ test.idl:9:28

  8 │ const Mode MODE1 = NORMAL;
  9 │ const Mode MODE2 = Mode::FAST;
    │                    ˆˆˆˆ used here
 10 │ const Mode MODE3 = SLOW;
 11 │ const Mode MODE4 = Mode::SLOW;

  ? use `FAST` instead of `Mode::FAST`
  * enumerators are registered in the parent scope

! scoped-lit: scoped enums are non-standard
