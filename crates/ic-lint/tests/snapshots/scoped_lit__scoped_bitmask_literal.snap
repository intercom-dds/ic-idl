! scoped-lit: scoped bitmasks are non-standard
  @ test.idl:8:43

 6 │ };
 7 │ 
 8 │ const Permissions DEFAULT_PERMS = Permissions::READ | Permissions::WRITE;
   │                                   ˆˆˆˆˆˆˆˆˆˆˆ used here

  ? use `READ` instead of `Permissions::READ`
  * bitmask flags are registered in the parent scope

