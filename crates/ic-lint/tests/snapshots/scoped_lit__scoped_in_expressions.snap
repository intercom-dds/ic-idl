! scoped-lit: scoped enums are non-standard
  @ test.idl:8:37

  6 │ };
  7 │ 
  8 │ const Level DEFAULT_LEVEL = Level::MEDIUM;
    │                             ˆˆˆˆˆ used here
  9 │ const Level FALLBACK = Level::LOW;

  ? use `MEDIUM` instead of `Level::MEDIUM`
  * enumerators are registered in the parent scope

! scoped-lit: scoped enums are non-standard
  @ test.idl:9:32

  8 │ const Level DEFAULT_LEVEL = Level::MEDIUM;
  9 │ const Level FALLBACK = Level::LOW;
    │                        ˆˆˆˆˆ used here

