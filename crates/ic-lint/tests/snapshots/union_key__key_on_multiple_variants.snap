error[invalid-annotation-target]: @key can only be applied to struct fields
    ┌ test.idl:10:6
    │
  8 │ union ColorData switch(Color) {
  9 │ case RED:
 10 │     @key long red_value;
    ·      ^^^ invalid annotation target
 11 │ case GREEN:
 12 │     @key long green_value;
    └──

error[invalid-annotation-target]: @key can only be applied to struct fields
    ┌ test.idl:12:6
    │
 10 │     @key long red_value;
 11 │ case GREEN:
 12 │     @key long green_value;
    ·      ^^^ invalid annotation target
