// Comprehensive annotations tests

module annotation_tests {
    // Key annotation
    struct KeyedStruct {
        @key long id_;
        @key string name;
        double value;
    };

    // Nested annotation
    @nested
    struct NestedStruct {
        long x;
        long y;
    };

    // Optional annotation
    struct OptionalFields {
        @optional long opt_id;
        @optional string opt_name;
        long required_field;
    };

    // ID annotation
    struct IdAnnotated {
        @id(1) long first;
        @id(2) string second;
        @id(10) double tenth;
    };

    // Extensibility annotations
    @appendable
    struct AppendableStruct {
        long a;
        long b;
    };

    @mutable
    struct MutableStruct {
        long x;
        long y;
    };

    @final
    struct FinalStruct {
        long value;
    };

    // Multiple annotations
    @appendable
    struct MultiAnnotated {
        @key long id_;
        @optional string name;
        double value;
    };

    // Bit-bound annotation
    struct BitBounded {
        @bit_bound(8) long small;
        @bit_bound(16) long medium;
        long normal;
    };
};
