module merge_shared_annotations {
    module merge_test {
        struct Position {
            double pos_x;
            double pos_y;
            double pos_z;
        };

        struct Velocity {
            double vel_x;
            double vel_y;
            double vel_z;
        };

        struct Debris {
            Position pos;
            @optional Velocity vel;
            double radius;
        };

        struct Description {
            string color;
            @external Debris last_sighting;
        };

        struct ClassifiedDescription {
            @default("big foot") string pilot;
            sequence<string> passengers;
        };

        struct UnidentifiedFlyingObject {
            @optional Debris deb;
            @external Description desc;
            @non_serialized ClassifiedDescription classified;
        };

        struct SimpleMerge {
            Position pos;
            string name;
        };

        struct DoubleMerge {
            Position pos;
            Velocity vel;
            double mass;
        };

        struct NestedMerge {
            SimpleMerge simple;
            long id_;
        };
    };

    module shared_test {
        struct Leaf {
            int8 i8;
        };

        struct Branch {
            @shared Leaf leaf_ptr;
        };

        struct Root {
            int8 i8;
            @shared int8 i8_ptr;
            @external Leaf leaf_ptr;
            @external Branch branch_ptr;
        };

        const Leaf k_leaf = {1};
        const Branch k_branch = {{2}};
        const Root k_root = {4, 8, {16}, {{32}}};

        struct SharedPrimitives {
            @shared long long_ptr;
            @shared string string_ptr;
            @shared double double_ptr;
        };

        struct SharedStructs {
            @shared Leaf leaf;
            @shared Branch branch;
        };

        struct MixedShared {
            @shared Leaf shared_leaf;
            Leaf normal_leaf;
            @shared long shared_long;
            long normal_long;
        };
    };

    module default_literal_test {
        struct SimpleStruct {
            int8 i8;
        };

        typedef SimpleStruct SimpleStructAlias;

        // union UnionWithDefaultStructures switch(octet) {
        //     default:
        //         @default({i8=8}) SimpleStruct a;
        //     case 2:
        //         @default({i8=16}) SimpleStructAlias b;
        // };

        struct ComplexStruct {
            int8 i8;
            long l;
        };

        // union ComplexUnionWithDefaults switch(short) {
        //     case 1:
        //         @default({i8=1, l=100}) ComplexStruct c1;
        //     case 2:
        //         @default({i8=2, l=200}) ComplexStruct c2;
        //     default:
        //         @default({i8=0, l=0}) ComplexStruct c_default;
        // };
    };

    module combined_test {
        struct Point {
            double x;
            double y;
        };

        struct Circle {
            Point center;
            double radius;
        };

        struct Scene {
            @shared Circle main_circle;
            Point offset;
            string name;
        };

        struct ComplexScene {
            @shared Scene scene;
            @external Circle extra_circle;
            long id_;
        };
    };
};
