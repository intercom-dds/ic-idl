// Name conflict scenarios and scoping edge cases

module name_conflicts {
    // Same name in different scopes
    struct Data {
        long value;
    };

    module inner {
        struct Data {
            string text;
        };

        struct Container {
            Data inner_data;
            name_conflicts::Data outer_data;
        };
    };

    // Typedef with same name as struct in different scope
    typedef long MyType;

    module sub {
        struct MyType {
            long value;
        };

        struct UsesBoth {
            MyType struct_type;
            name_conflicts::MyType typedef_type;
        };
    };

    // Enum and struct with same name in different modules
    enum Status {
        OK,
        ERROR
    };

    module other {
        struct Status {
            long code;
            string message;
        };
    };

    // Reopened module with potential conflicts
    module reopened {
        struct First {
            long a;
        };
    };

    module reopened {
        struct Second {
            long b;
        };

        struct UsesFirst {
            First ref;
        };
    };

    // Same field name in base and derived (not allowed, causes duplicate)
    struct Base {
        long base_value;
    };

    struct Derived : Base {
        string derived_value;
    };

    // Union cases with same type but different names
    union SameTypeUnion switch (long) {
        case 1: long first_long;
        case 2: long second_long;
        case 3: long third_long;
    };

    // Constants with same value
    const long CONST_A = 100;
    const long CONST_B = 100;
    const long CONST_C = CONST_A;

    // Multiple typedefs of same type
    typedef long Long1;
    typedef long Long2;
    typedef long Long3;

    struct MultipleTypedefs {
        Long1 l1;
        Long2 l2;
        Long3 l3;
    };

    // Nested modules with same inner name
    module group_a {
        module common {
            struct Item {
                long a_value;
            };
        };
    };

    module group_b {
        module common {
            struct Item {
                string b_value;
            };
        };
    };

    struct UsesNested {
        group_a::common::Item item_a;
        group_b::common::Item item_b;
    };
};
