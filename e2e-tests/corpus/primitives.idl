// Comprehensive test for all primitive types

module primitive_types {
    // Integer types
    struct IntegerTypes {
        short s;
        unsigned short us;
        long l;
        unsigned long ul;
        long long ll;
        unsigned long long ull;
        int8 i8;
        uint8 ui8;
        int16 i16;
        uint16 ui16;
        int32 i32;
        uint32 ui32;
        int64 i64;
        uint64 ui64;
    };

    // Floating point types
    struct FloatingTypes {
        float f;
        double d;
        long double ld;
    };

    // Character and boolean types
    struct CharBoolTypes {
        char c;
        wchar wc;
        boolean b;
        octet o;
    };

    // String types
    struct StringTypes {
        string unbounded_str;
        string<256> bounded_str;
        wstring unbounded_wstr;
        wstring<128> bounded_wstr;
    };

    // All primitives in one struct
    struct AllPrimitives {
        boolean flag;
        char letter;
        octet byte;
        short small_num;
        long num;
        long long big_num;
        float decimal;
        double precise;
        string text;
    };
};
