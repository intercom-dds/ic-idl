// @ext::rename annotation tests

module rename_annotation {
    enum RenamedEnum {
        FIELD_ONE,
        @ext::rename("RENAMED_TWO")
        FIELD_TWO,
        @ext::rename("RENAMED_THREE")
        FIELD_THREE,
        FIELD_FOUR
    };

    union RenamedUnion switch (RenamedEnum) {
        case FIELD_ONE:
            long my_int;
        case FIELD_TWO:
            @ext::rename("renamed_int")
            long my_other_int;
        case FIELD_THREE:
            string my_string;
        case FIELD_FOUR:
            @ext::rename("renamed_double")
            double my_double;
    };

    struct RenamedStruct {
        @ext::rename("renamed_string")
        string my_string;

        @ext::rename("renamed_enum")
        RenamedEnum my_enum;

        @ext::rename("renamed_union")
        RenamedUnion my_union;

        double my_double;

        @ext::rename("renamed_long")
        long my_long;
    };

    struct MultipleRenamed {
        @ext::rename("a")
        long field_a;

        @ext::rename("b")
        string field_b;

        @ext::rename("c")
        double field_c;

        @ext::rename("d")
        boolean field_d;
    };

    struct PartiallyRenamed {
        @ext::rename("renamed_field1")
        long field1;
        long field2;
        @ext::rename("renamed_field3")
        string field3;
        double field4;
    };

    enum PartiallyRenamedEnum {
        VALUE_A,
        @ext::rename("VALUE_B_RENAMED")
        VALUE_B,
        VALUE_C,
        @ext::rename("VALUE_D_RENAMED")
        VALUE_D
    };
};
