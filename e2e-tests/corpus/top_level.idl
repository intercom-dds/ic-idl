// Top-level declarations (outside modules)

// Top-level constants
const long TOP_CONST = 100;
const string TOP_STRING = "global";
const double PI = 3.14159;

// Top-level enum
enum GlobalStatus {
    INIT,
    RUNNING,
    STOPPED,
    ERROR
};

// Top-level struct
struct GlobalData {
    long id_;
    string name;
};

// Top-level typedef
typedef sequence<long> GlobalIntSeq;
typedef string<256> GlobalString;

// Top-level union
union GlobalUnion switch (long) {
    case 1: long int_val;
    case 2: string str_val;
    default: boolean flag;
};

// Module using top-level types
module uses_top_level {
    struct Container {
        GlobalData data;
        GlobalStatus status;
        GlobalIntSeq numbers;
        GlobalUnion value;
    };

    const long MODULE_CONST = TOP_CONST * 2;

    struct WithTopConst {
        long array[TOP_CONST];
    };
};

// Another top-level struct
struct AnotherGlobal {
    GlobalData nested;
};

// Top-level forward declaration
struct ForwardGlobal;

struct UsesForwardGlobal {
    sequence<ForwardGlobal> ref;
};

struct ForwardGlobal {
    long value;
};
