// Valuetype tests

module valuetypes {
    // Simple valuetype
    valuetype SimpleValue {
        public long id_;
        public string name;
    };

    // Valuetype with private members
    valuetype MixedValue {
        public long public_field;
        private string private_field;
        public double another_public;
    };

    // Valuetype inheritance
    valuetype BaseValue {
        public long base_id;
    };

    valuetype DerivedValue : BaseValue {
        public string derived_name;
    };

    // Multi-level valuetype inheritance
    valuetype Level1Value {
        public long l1;
    };

    valuetype Level2Value : Level1Value {
        public long l2;
    };

    valuetype Level3Value : Level2Value {
        public long l3;
    };

    // Valuetype with sequences
    valuetype CollectionValue {
        public sequence<long> numbers;
        public sequence<string, 10> names;
    };

    // Valuetype with struct member
    struct EmbeddedStruct {
        long x;
        long y;
    };

    valuetype ValueWithStruct {
        public EmbeddedStruct embedded;
        public long id_;
    };

    valuetype AbstractValue {
        public long id_;
    };

    valuetype ConcreteValue : AbstractValue {
        public string name;
    };

    // Valuetype with custom modifier (not supported, removing)
    valuetype CustomLikeValue {
        public long value;
    };

    // Valuetype with all primitive types
    valuetype AllTypes {
        public short s;
        public long l;
        public long long ll;
        public float f;
        public double d;
        public boolean b;
        public char c;
        public octet o;
        public string str;
    };

    // Struct containing valuetype
    struct ValueContainer {
        SimpleValue val;
        long id_;
    };

    // Sequence of valuetypes
    struct ValueSequence {
        sequence<SimpleValue> values;
    };

    // Valuetype with factory (custom init)
    valuetype FactoryValue {
        public long id_;
        public string name;
    };
};
