#endif

#define NO_SANITIZE(x) THREAD_ANNOTATION_ATTRIBUTE__(no_sanitize(x))

namespace {
const std::array<uint8_t, 64> PADDING = {
    0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
};

// Support function for round-robin rol
unsigned int rol(unsigned int x, unsigned int steps) {
    return (x << steps) | (x >> (32 - steps));
}

// Transform buffer[0]-buffer[3] into an unsigned integer
NO_SANITIZE("integer")
unsigned int decode(const uint8_t* buffer) {
    return (buffer[0] << 0) + (buffer[1] << 8) + (buffer[2] << 16) + (buffer[3] << 24);
}

// Transform an unsigned integer value into a octet buffer (must be at least 4 bytes long)
void encode(unsigned int value, uint8_t* destination) {
    destination[0] = (value >> 0) & 0xff;
    destination[1] = (value >> 8) & 0xff;
    destination[2] = (value >> 16) & 0xff;
    destination[3] = (value >> 24) & 0xff;
}

