// Lookup constants for auxiliary functions
struct KSIvector {
    unsigned int k;
    unsigned int s;
    unsigned int i;
};

// These tables are found in the algortihm description from page 5 of the specification
KSIvector KSIround1[16] = {
    {0, 7, 1},
    {1, 12, 2},
    {2, 17, 3},
    {3, 22, 4},
    {4, 7, 5},
    {5, 12, 6},
    {6, 17, 7},
    {7, 22, 8},
    {8, 7, 9},
    {9, 12, 10},
    {10, 17, 11},
    {11, 22, 12},
    {12, 7, 13},
    {13, 12, 14},
    {14, 17, 15},
    {15, 22, 16}
};

KSIvector KSIround2[16] = {
    {1, 5, 17},
    {6, 9, 18},
    {11, 14, 19},
    {0, 20, 20},
    {5, 5, 21},
    {10, 9, 22},
    {15, 14, 23},
    {4, 20, 24},
    {9, 5, 25},
    {14, 9, 26},
    {3, 14, 27},
    {8, 20, 28},
    {13, 5, 29},
    {2, 9, 30},
    {7, 14, 31},
    {12, 20, 32}
};

KSIvector KSIround3[16] = {
    {5, 4, 33},
    {8, 11, 34},
    {11, 16, 35},
    {14, 23, 36},
    {1, 4, 37},
    {4, 11, 38},
