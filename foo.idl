valuetype Example {
    enum Status {
        ACTIVE,
        INACTIVE
    };
    
    struct Data {
        string name;
        long value;
    };
    
    // These fail to resolve:
    public Status current_status;        // Error: unresolved type `Status`
    public Data info;                    // Error: unresolved type `Data`
    
    // Operations using nested types also fail:
    Status getStatus();                  // Error: unresolved type `Status`
    void updateData(in Data new_data);   // Error: unresolved type `Data`
};
