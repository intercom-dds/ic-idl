module custom_annotations {
    @annotation shared {};
    @annotation optional {};
};

@autoid(HASH)
module autoid_hash_types {
    struct ModuleHash {
        long camelCase;
        @hashid("custom_hash") long hash_name;
        @id(42) long explicit_id;
        long thread_local;
    };

    @autoid(SEQUENTIAL)
    struct SequentialOverride {
        long x;
        long y;
    };

    union HashUnion switch (long) {
        case 0: long member1;
        default: long member2;
    };
};

module annotation_types {
    struct KeyedStruct {
        @key long id;
        string name;
        double value;
    };

    struct MultiKeyStruct {
        @key string namespace;
        @key long id;
        string data;
    };

    struct OptionalStruct {
        long required_field;
        @optional long optional_int;
        @optional string optional_string;
        @optional sequence<long> optional_seq;
    };

    enum OptionalKind {
        FIRST,
        @default_literal SECOND
    };

    bitmask OptionalFlags {
        ENABLED
    };

    typedef long OptionalAlias;

    struct OptionalTypes {
        @optional(TRUE) boolean maybe_bool;
        @optional char maybe_char;
        @optional @default(1.5) double maybe_double;
        @optional fixed<10, 2> maybe_fixed;
        @optional OptionalKind maybe_kind;
        @optional OptionalFlags maybe_flags;
        @optional OptionalAlias maybe_alias;
        @optional map<string, long> maybe_map;
        @optional long maybe_array[3];
        @optional long maybe_matrix[2][3];
    };

    struct OptionalDerived : OptionalStruct {
        @optional long maybe_other;
    };

    struct NonOptionalFields {
        @optional(FALSE) long required_int;
        @optional(FALSE) string required_string;
        @optional(FALSE) sequence<long> required_seq;
        @custom_annotations::optional long custom_int;
    };

    exception OptionalError {
        @optional long code;
        @optional string reason;
    };

    valuetype OptionalValue {
        @optional public long number;
        @optional public string text;
    };

    union OptionalUnion switch (long) {
        case 0:
        case 1: @optional long number;
        default: @optional string text;
    };

    @nested
    struct NestedStruct {
        long x;
        long y;
    };

    struct SharedRefs {
        @shared string shared_string;
        @external NestedStruct shared_struct;
    };

    struct CombinedAnnotations {
        @key long id;
        @optional string maybe_shared_name;
    };

    struct CustomSharedName {
        @custom_annotations::shared long value;
    };

    interface AnnotatedInterface {
        @oneway void fire_and_forget(in string message);

        long get_value();
        void set_value(in long value);
    };

    @topic
    struct TopicMessage {
        @key long message_id;
        string payload;
        long timestamp;
    };

    @mutable
    struct MutableStruct {
        long version;
        string data;
    };

    @final
    struct FinalStruct {
        long fixed_field;
    };
};
