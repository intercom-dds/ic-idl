// Test bounded collections and strings
// Note: Bounds are not enforced at runtime in Python, but we verify they parse correctly

module bounded_types {
    // Bounded strings
    typedef string<32> ShortString;
    typedef string<256> MediumString;
    typedef string<4096> LongString;

    // Bounded sequences
    typedef sequence<long, 10> SmallIntList;
    typedef sequence<string, 100> StringList100;
    typedef sequence<double, 1000> LargeDoubleList;

    // Struct with bounded fields
    struct BoundedFields {
        string<64> name;
        string<256> description;
        sequence<long, 50> values;
        sequence<string<32>, 10> tags;
    };

    // Nested bounded types
    struct NestedBounded {
        sequence<sequence<long, 10>, 5> matrix;
        map<string<32>, sequence<long, 100>> indexed_lists;
    };

    // Typedef chains with bounds
    typedef string<100> Name;
    typedef sequence<Name, 50> NameList;
    typedef map<Name, NameList> NameMap;

    // Mixed bounded and unbounded
    struct MixedBounds {
        string<100> bounded_string;
        string unbounded_string;
        sequence<long, 10> bounded_seq;
        sequence<long> unbounded_seq;
    };
};
