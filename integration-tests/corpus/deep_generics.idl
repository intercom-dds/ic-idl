module deep_generic_types {
    struct TwoLevelSeq {
        sequence<sequence<long>> matrix;
    };

    struct ThreeLevelSeq {
        sequence<sequence<sequence<long>>> cube;
    };

    struct MapOfSeq {
        map<string, sequence<long>> indexed_lists;
    };

    struct SeqOfMap {
        sequence<map<string, long>> list_of_dicts;
    };

    struct MapOfMap {
        map<string, map<string, long>> nested_dict;
    };

    struct MapSeqMap {
        map<string, sequence<map<string, long>>> complex_structure;
    };

    struct SeqMapSeq {
        sequence<map<string, sequence<long>>> inverse_structure;
    };

    struct FourLevelDeep {
        sequence<sequence<sequence<sequence<long>>>> hypercube;
    };

    struct Point {
        long x;
        long y;
    };

    struct SeqOfPoints {
        sequence<Point> points;
    };

    struct MapOfPoints {
        map<string, Point> named_points;
    };

    struct SeqOfSeqOfPoints {
        sequence<sequence<Point>> point_matrix;
    };

    struct MapOfSeqOfPoints {
        map<string, sequence<Point>> point_lists;
    };

    typedef sequence<long> IntList;
    typedef sequence<IntList> IntMatrix;
    typedef map<string, IntMatrix> NamedMatrices;

    struct UsingTypedefChain {
        NamedMatrices data;
    };

    struct ArrayOfSeq {
        sequence<long> items[3];
    };

    // Requires typedef indirection - can't write sequence<long[3]> directly
    typedef long ThreeInts[3];

    struct SeqOfArray {
        sequence<ThreeInts> fixed_triples;
    };

    struct MapOfArray {
        map<string, ThreeInts> named_triples;
    };
};
