module default_types {
    const string DEFAULT_NAME = "unnamed";
    const long DEFAULT_COUNT = 100;
    const double DEFAULT_RATE = 0.5;

    struct PrimitiveDefaults {
        boolean bool_empty;
        @default(TRUE) boolean bool_true;
        @default(FALSE) boolean bool_false;

        long int_empty;
        @default(42) long int_value;
        @default(-100) long int_negative;

        double float_empty;
        @default(3.14159) double float_value;
        @default(-0.5) double float_negative;

        string string_empty;
        @default("hello") string string_value;
        @default(DEFAULT_NAME) string string_from_const;
    };

    struct ArrayDefaults {
        long array_empty[3];
        @default({1, 2, 3}) long array_values[3];
        @default({10, 20}) long array_partial[2];
        
        @default({1, 2, 3}) @external long array_external[3];

        string string_array_empty[2];
        @default({"foo", "bar"}) string string_array_values[2];
    };

    struct SequenceDefaults {
        sequence<long> seq_empty;
        @default({1, 2, 3, 4, 5}) sequence<long> seq_values;

        sequence<string> string_seq_empty;
        @default({"a", "b", "c"}) sequence<string> string_seq_values;
    };

    struct MapDefaults {
        map<string, long> map_empty;
        @default({{"one", 1}, {"two", 2}}) map<string, long> map_values;

        map<long, string> reverse_map_empty;
        @default({{1, "one"}, {2, "two"}}) map<long, string> reverse_map_values;
    };

    struct Inner {
        long x;
        string y;
    };

    // Workaround: inline struct literals not supported, must use const
    const Inner DEFAULT_INNER = {10, "default"};
    const Inner NESTED_INNER = {99, "nested"};

    struct OuterDefaults {
        Inner inner_empty;
        @default(NESTED_INNER) Inner inner_literal;
        @default(DEFAULT_INNER) Inner inner_from_const;
    };

    enum Priority {
        LOW = 0,
        @default_literal MEDIUM = 1,
        HIGH = 2
    };

    struct EnumDefaults {
        Priority priority_empty;
        @default(HIGH) Priority priority_high;
    };

    struct OptionalFields {
        @optional long maybe_int;
        @optional string maybe_string;
        @optional Inner maybe_struct;
    };

    struct ComplexDefaults {
        @default({{1, 2}, {3, 4}}) sequence<sequence<long>> nested_seq;
        @default({{"a", {1, 2}}, {"b", {3, 4}}}) map<string, sequence<long>> map_of_seq;
    };

    union UnionExternalDefault switch(@default(1) octet) {
    case 1:
        @default(42) @external int32 my_int;
    default:
        @external string my_str;
    };

    union UnionDefaultTwoCases switch (@default(2) long) {
    case 1:
    case 2:
        long value;
    };
};
