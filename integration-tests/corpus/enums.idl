module enum_types {
    enum Color {
        RED,
        GREEN,
        BLUE
    };

    enum Status {
        OK = 0,
        WARNING = 100,
        ERROR = 200
    };

    enum GappedEnum {
        FIRST = 0,
        SECOND = 5,
        THIRD = 10,
        FOURTH = 100
    };

    enum NegativeEnum {
        NEG_TWO = -2,
        NEG_ONE = -1,
        ZERO = 0,
        POS_ONE = 1
    };

    enum MixedEnum {
        AUTO_FIRST,
        EXPLICIT_TEN = 10,
        AUTO_ELEVEN,
        EXPLICIT_HUNDRED = 100,
        AUTO_HUNDRED_ONE
    };

    const Status ENUM_CONST = WARNING;
};
