module interface_types {
    interface Reader {
        string read();
        boolean has_more();
    };

    interface Writer {
        void write(in string data);
        void flush();
    };

    interface ReadWriter : Reader, Writer {
        void reset();
    };

    interface Calculator {
        long add(in long a, in long b);
        long subtract(in long a, in long b);
        double divide(in double a, in double b);
    };

    interface Empty {
    };

    interface WithAttribute {
        readonly attribute string name;
        attribute long count;
    };

    exception OperationFailed {
        long error_code;
        string reason;
    };

    exception InvalidInput {
        string parameter_name;
    };

    interface WithOutParams {
        void get_values(out long x, out long y);
        void swap(inout long a, inout long b);
        long process(in long input, out string result);
        void mixed_params(in string name, inout long counter, out boolean success);
    };

    interface WithRaises {
        void safe_operation();
        void risky_operation() raises (OperationFailed);
        void complex_operation() raises (OperationFailed, InvalidInput);
        long compute(in long value) raises (InvalidInput);
    };

    interface CombinedFeatures {
        void do_work(in string task, out long result) raises (OperationFailed);
        void update(inout long value) raises (InvalidInput, OperationFailed);
    };
};
