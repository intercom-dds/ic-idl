// Test multiple modules in one file and module reopening

// First module
module module_a {
    struct StructA1 {
        long value;
    };

    const long CONST_A1 = 100;

    enum EnumA {
        X,
        Y
    };
};

// Second module (sibling)
module module_b {
    struct StructB1 {
        string name;
    };

    const long CONST_B1 = 200;
};

// Reopen module_a to add more types
module module_a {
    struct StructA2 {
        double data;
        StructA1 ref_to_a1;
    };

    const long CONST_A2 = 101;

    enum EnumA2 {
        P,
        Q,
        R
    };
};

// Reopen module_b
module module_b {
    struct StructB2 {
        long id;
        StructB1 ref_to_b1;
    };

    const long CONST_B2 = 201;
};

// Reopen module_a a third time
module module_a {
    struct StructA3 {
        boolean flag;
        StructA1 a1;
        StructA2 a2;
    };

    const long CONST_A3 = 102;
};

// Empty module
module empty_module {
};

// Module with only constants
module constants_only {
    const long C1 = 1;
    const long C2 = 2;
    const long C3 = 3;
};

// Module with only enums
module enums_only {
    enum Color {
        RED,
        GREEN,
        BLUE
    };

    enum Size {
        SMALL,
        MEDIUM,
        LARGE
    };
};
