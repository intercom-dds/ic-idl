// Test string, char, wchar, wstring types and Unicode handling

module char_wstring_types {
    // Char constants
    const char CHAR_A = 'A';
    const char CHAR_DIGIT = '5';
    const char CHAR_SPACE = ' ';
    const char CHAR_NEWLINE = '\n';
    const char CHAR_TAB = '\t';
    const char CHAR_QUOTE = '\'';
    const char CHAR_BACKSLASH = '\\';

    const wchar WCHAR_A = L'A';
    const wchar WCHAR_OMEGA = 937;
    const wchar WCHAR_CHINESE = 20013;

    const wstring WSTRING_HELLO = L"Hello";
    const wstring WSTRING_UNICODE = L"日本語テスト";
    const wstring WSTRING_EMOJI = L"🎉🚀";
    const wstring WSTRING_EMPTY = L"";

    // Struct with char fields
    struct CharFields {
        char single_char;
        wchar wide_char;
    };

    // Struct with wstring fields
    struct WstringFields {
        wstring wide_text;
        string narrow_text;
    };

    // Sequence of chars
    struct CharSequences {
        sequence<char> char_seq;
        sequence<wchar> wchar_seq;
    };

    // Mixed char and wstring
    struct MixedCharTypes {
        char letter;
        wchar wide_letter;
        string text;
        wstring wide_text;
    };
};

module unicode_types {
    // Basic Latin with accents
    const string FRENCH = "café résumé naïve";
    const string GERMAN = "größe über müde";
    const string SPANISH = "señor mañana niño";

    // Nordic characters
    const string NORWEGIAN = "blåbær ærlig øl";
    const string SWEDISH = "smörgås älg ö";

    // Greek
    const string GREEK = "αβγδ Ωμέγα";

    // Cyrillic
    const string RUSSIAN = "привет мир";

    // CJK (Chinese, Japanese, Korean)
    const string CHINESE = "你好世界";
    const string JAPANESE = "こんにちは世界";
    const string KOREAN = "안녕하세요";

    // Emoji
    const string EMOJI = "🎉🚀💻🔥";

    // Mixed scripts in one string
    const string MIXED = "Hello 世界 🌍 café";

    // Special characters that need escaping
    const string QUOTES = "He said \"hello\"";
    const string BACKSLASH = "path\\to\\file";
    const string NEWLINE = "line1\nline2";
    const string TAB = "col1\tcol2";

    // Empty and whitespace
    const string EMPTY = "";
    const string SPACES = "   ";
    const string UNICODE_SPACES = " \u00A0 ";

    // Mathematical symbols
    const string MATH = "∑∏∫√∞≠≤≥";

    // Currency symbols
    const string CURRENCY = "$ € £ ¥ ₹ ₽";

    // Arrows and symbols
    const string ARROWS = "← → ↑ ↓ ↔ ⇒";

    // Struct with Unicode field values for runtime testing
    struct UnicodeData {
        string label;
        string description;
    };
};
