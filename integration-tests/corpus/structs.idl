module struct_types {
    struct Point {
        long x;
        long y;
    };

    struct Point3D : Point {
        long z;
    };

    struct Point4D : Point3D {
        long w;
    };

    struct Rectangle {
        Point top_left;
        Point bottom_right;
    };

    struct AllPrimitives {
        boolean bool_val;
        octet byte_val;
        short short_val;
        unsigned short ushort_val;
        long long_val;
        unsigned long ulong_val;
        long long longlong_val;
        unsigned long long ulonglong_val;
        float float_val;
        double double_val;
        string string_val;
    };

    struct WithDefaults {
        long count;
        string name;
        double value;
    };

    struct WithSequence {
        sequence<long> numbers;
        sequence<string> names;
    };

    struct WithArray {
        long fixed_numbers[5];
    };

    struct WithMap {
        map<string, long> string_to_int;
    };

    struct Empty {
    };
};
