module typedef_types {
    // Primitive typedefs
    typedef long Integer;
    typedef unsigned long UnsignedInteger;
    typedef double Real;
    typedef string Text;
    typedef boolean Flag;
    typedef octet Byte;

    // Sequence typedefs
    typedef sequence<long> IntList;
    typedef sequence<string> StringList;
    typedef sequence<double> RealList;

    // Nested typedef (typedef of typedef)
    typedef Integer Count;
    typedef Text Label;

    // Deep typedef chains (5 levels)
    typedef long Level1;
    typedef Level1 Level2;
    typedef Level2 Level3;
    typedef Level3 Level4;
    typedef Level4 Level5;

    typedef sequence<long> SeqLevel1;
    typedef SeqLevel1 SeqLevel2;
    typedef SeqLevel2 SeqLevel3;

    typedef map<string, long> MapLevel1;
    typedef MapLevel1 MapLevel2;
    typedef MapLevel2 MapLevel3;

    // Map typedefs
    typedef map<string, long> StringIntMap;
    typedef map<string, string> StringStringMap;

    // Array typedef
    typedef long LongArray[10];

    struct Point {
        Real x;
        Real y;
    };

    struct Person {
        Text name;
        Integer age;
        Flag active;
    };

    struct Container {
        IntList numbers;
        StringList labels;
        StringIntMap lookup;
    };

    struct Measurement {
        Label name;
        Count value;
    };

    struct WithArrayTypedef {
        LongArray values;
    };

    struct DeepChainStruct {
        Level5 deep_int;
        SeqLevel3 deep_seq;
        MapLevel3 deep_map;
    };
};
