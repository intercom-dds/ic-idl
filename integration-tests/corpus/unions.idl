module union_types {
    union IntOrString switch (long) {
    case 1:
        long int_val;
    case 2:
        string str_val;
    default:
        boolean default_val;
    };

    enum ValueKind {
        INT_KIND,
        FLOAT_KIND,
        STRING_KIND
    };

    union TypedValue switch (ValueKind) {
    case INT_KIND:
        long int_value;
    case FLOAT_KIND:
        double float_value;
    case STRING_KIND:
        string string_value;
    };

    union BoolSwitch switch (boolean) {
    case TRUE:
        long true_val;
    case FALSE:
        string false_val;
    };

    union MultiCase switch (long) {
    case 1:
    case 2:
    case 3:
        long small_val;
    case 10:
    case 20:
        string text_val;
    default:
        boolean flag;
    };

    union ImplicitPrimitiveDisc switch (long) {
    case 1:
        long long_val;
    case 2:
    case 3:
        short short_val;
    };

    union ImplicitEnumDisc switch (ValueKind) {
    case INT_KIND:
        long int_val;
    case FLOAT_KIND:
        double float_val;
    };
};
