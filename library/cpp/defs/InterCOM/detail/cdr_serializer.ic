#ifndef INTERCOM_CDRSERIALIZER_IC
#define INTERCOM_CDRSERIALIZER_IC

#include <cassert>
#include <cstring>
#include <stdexcept>

#include "InterCOM/buffer.h"
#include "InterCOM/cdr_serializer.h"
#include "InterCOM/dds_xtypes_constants.h"
