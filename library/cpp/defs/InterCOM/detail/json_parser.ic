template <typename T>
inline JsonNode json_error(const T& node, const char* str) {
    JsonData data(str, strlen(str), 0, node.line());
    return {JSON_PARSE_ERROR, data};
}

template <typename T>
inline char32_t read_hex(T& reader) {
    char32_t code = 0;
    for (int i = 0; i < 4; ++i) {
        int c = reader.getc();
        if (c >= '0' && c <= '9') {
            code = (code << 4) + (c - '0');
        } else if (c >= 'a' && c <= 'f') {
            code = (code << 4) + (c - 'a') + 10;
        } else if (c >= 'A' && c <= 'F') {
            code = (code << 4) + (c - 'A') + 10;
        } else {
            return UNICODE_INVALID;
        }
    }
    return code;
}

inline char hex_character(int value) {
    if (value >= 0 && value < 10) {
        return static_cast<char>('0' + value);
    }
    if (value < 16) {
        return static_cast<char>('a' + value - 10);
    }
    return '0';
}

template <typename T>
inline char32_t read_unicode(T& reader) {
    char32_t code = 0;
    int c = reader.getc();
    if (c == '\\') {
        c = reader.getc();
        if (c == 'u') {
            code = read_hex(reader);
            if ((code & ~0x7FF) == 0xD800) {  // Surrogate pair
                if (reader.getc() == '\\' && reader.getc() == 'u') {
                    char16_t pair[2];
                    pair[0] = static_cast<uint16_t>(code);
                    pair[1] = static_cast<uint16_t>(read_hex(reader));
                    read_char_code<UTF16>(code, pair);
                } else {
                    code = UNICODE_INVALID;
                }
            }
        } else {
            switch (c) {
            case '\\':
                code = '\\';
                break;
            case '"':
                code = '"';
                break;
            case '/':
                code = '/';
                break;
            case 'b':
                code = '\b';
                break;
            case 'f':
                code = '\f';
                break;
            case 'n':
                code = '\n';
                break;
            case 'r':
                code = '\r';
                break;
            case 't':
                code = '\t';
                break;
            default:
                code = UNICODE_INVALID;
                break;
            }
        }
    } else {
        int extra_bytes = 0;
        if ((c & 0x80) == 0) {
            extra_bytes = 0;
            // code_min = 0x20;
            code = static_cast<char32_t>(c);
        } else if ((c & 0xE0) == 0xC0) {
            extra_bytes = 1;
            // code_min = 0x80;
            code = static_cast<char32_t>(c & 0x1F);
        } else if ((c & 0xF0) == 0xE0) {
            extra_bytes = 2;
            // code_min = 0x800;
            code = static_cast<char32_t>(c & 0x0F);
        } else if ((c & 0xF8) == 0xF0) {
            extra_bytes = 3;
            // code_min = 0x10000;
            code = static_cast<char32_t>(c & 0x07);
        } else if ((c & 0xC0) == 0x80) {
            while ((reader.peek() & 0xC0) == 0x80) {
                reader.getc();
            }
            code = UNICODE_INVALID;
        }
        for (int i = 1; i <= extra_bytes; ++i) {
            c = reader.getc();
            if ((c & 0xC0) == 0x80) {
                code = (code << 6) + static_cast<char32_t>(c & 0x3F);
            } else {
                code = UNICODE_INVALID;
                break;
            }
        }
        if (!is_legal_unicode(code) || code < 0x20) {
            code = UNICODE_INVALID;
        }
    }
    return code;
}

const char JSON_BEGIN_ARRAY = '[';

const char JSON_END_ARRAY = ']';

const char JSON_BEGIN_OBJECT = '{';

const char JSON_END_OBJECT = '}';

const char JSON_QUOTE = '"';

const char JSON_COLON = ':';

const char JSON_COMMA = ',';

const char JSON_TAB = '\t';

const char JSON_NEWLINE = '\n';

const char JSON_CR = '\r';

const char JSON_SPACE = ' ';

template <typename T>
inline void json_consume_ws(T& data) {
    while (true) {
        int c = data.peek();
        switch (c) {
        case JSON_TAB:
        case JSON_NEWLINE:
        case JSON_CR:
        case JSON_SPACE:
            data.getc();
            break;
        default:
            return;
        }
    }
}

template <typename T>
inline bool json_consume_separator(T& data, char sep) {
    json_consume_ws(data);
    if (data.getc() != sep) {
        return false;
    }
    json_consume_ws(data);
    return true;
}

template <typename T>
JsonNode json_consume_string(T& data);

template <typename T>
JsonNode json_consume_array(T& data, int level);

template <typename T>
JsonNode json_consume_object(T& data, int level);

template <typename T>
JsonNode json_consume_true(T& data);

template <typename T>
JsonNode json_consume_false(T& data);

template <typename T>
JsonNode json_consume_null(T& data);

template <typename T>
JsonNode json_consume_number(T& data);

template <typename T>
inline JsonNode json_parse(T& data, int level = 0) {
    JsonNode res;
    if (level < 1024) {
        json_consume_ws(data);
        switch (data.peek()) {
        case JSON_QUOTE:
            res = json_consume_string(data);
            break;
        case JSON_BEGIN_ARRAY:
            res = json_consume_array(data, level);
            break;
        case JSON_BEGIN_OBJECT:
            res = json_consume_object(data, level);
            break;
        case 'f':
            res = json_consume_false(data);
            break;
        case 't':
            res = json_consume_true(data);
            break;
        case 'n':
            res = json_consume_null(data);
            break;
        default:
            res = json_consume_number(data);
            break;
        }
    } else {
        res = json_error(data, "Nesting too deep");
    }
    return res;
}

inline bool is_numeric(int c) {
    return c >= '0' && c <= '9';
}

template <typename T>
inline JsonNode json_consume_number(T& data) {
    typename T::state_type start_pos = data.current();
    bool has_frac = false;
    int c = data.getc();
    if (c == '-') {
        c = data.getc();
    }
    if (c == '0') {
        c = data.peek();
    } else {
        if (c >= '1' && c <= '9') {
            c = data.peek();
        } else {
            return json_error(start_pos, "Malformed number, no integer digit");
        }
        while (is_numeric(c)) {
            data.getc();
            c = data.peek();
        }
    }
    if (c == '.') {
        has_frac = true;
        data.getc();
        c = data.getc();
        if (is_numeric(c)) {
            c = data.peek();
        } else {
            return json_error(start_pos, "Malformed number, no number in fraction");
        }
        while (is_numeric(c)) {
            data.getc();
            c = data.peek();
        }
    }
    if (c == 'e' || c == 'E') {
        has_frac = true;
        data.getc();
        c = data.getc();
        if (c == '+' || c == '-') {
            c = data.getc();
        }
        if (is_numeric(c)) {
            c = data.peek();
        } else {
            return json_error(start_pos, "Malformed number, missing exponential after e");
        }
        while (is_numeric(c)) {
            data.getc();
            c = data.peek();
        }
    }
    return {has_frac ? JSON_FLOAT : JSON_INTEGER, data.from_state(start_pos)};
}

template <typename T>
inline JsonNode json_consume_null(T& data) {
    if (data.getc() == 'n' && data.getc() == 'u' && data.getc() == 'l' && data.getc() == 'l') {
        return {JSON_NULL, "null"};
    }
    return json_error(data, "Expected null value");
}

template <typename T>
inline JsonNode json_consume_true(T& data) {
    if (data.getc() == 't' && data.getc() == 'r' && data.getc() == 'u' && data.getc() == 'e') {
        return {JSON_BOOL, "true"};
    }
    return json_error(data, "Expected true value");
}

template <typename T>
inline JsonNode json_consume_false(T& data) {
    if (data.getc() == 'f' && data.getc() == 'a' && data.getc() == 'l' && data.getc() == 's' &&
        data.getc() == 'e') {
        return {JSON_BOOL, "false"};
    }
    return json_error(data, "Expected false value");
}

template <typename T>
inline JsonNode json_consume_object(T& data, int level) {
    data.getc();
    json_consume_ws(data);
    typename T::state_type start_pos = data.current();
    typename T::state_type end_pos = data.current();
    size_t element_count = 0;
    if (data.peek() != JSON_END_OBJECT) {
        for (;;) {
            {
                JsonNode key = json_parse(data, level + 1);
                if (key.get_type() != JSON_STRING) {
                    return json_error(start_pos, "JSON object expected string key");
                }
                if (key.get_type() == JSON_PARSE_ERROR) {
                    return key;
                }
            }
            if (!json_consume_separator(data, JSON_COLON)) {
                return json_error(start_pos, "Expected JSON_COLON separator");
            }
            {
                JsonNode value = json_parse(data, level + 1);
                if (value.get_type() == JSON_PARSE_ERROR) {
                    return value;
                }
            }
            ++element_count;
            end_pos = data.current();
            json_consume_ws(data);
            int c = data.getc();
            if (c == JSON_END_OBJECT) {
                break;
            }
            if (c != JSON_COMMA) {
                return json_error(start_pos, "Expected JSON_COMMA separator or end of object");
            }
        }
    } else {
        data.getc();
    }
    return {JSON_OBJECT, end_pos.from_state(start_pos), element_count};
}

template <typename T>
inline JsonNode json_consume_array(T& data, int level) {
    data.getc();
    json_consume_ws(data);
    typename T::state_type start_pos = data.current();
    typename T::state_type end_pos = data.current();
    size_t element_count = 0;
    if (data.peek() != JSON_END_ARRAY) {
        for (;;) {
            {
                JsonNode value = json_parse(data, level + 1);
                if (value.get_type() == JSON_PARSE_ERROR) {
                    return value;
                }
            }
            end_pos = data.current();
            ++element_count;
            json_consume_ws(data);
            int c = data.getc();
            if (c == JSON_END_ARRAY) {
                break;
            }
            if (c != JSON_COMMA) {
                return json_error(start_pos, "Expected JSON_COMMA separator or end of object");
            }
        }
    } else {
        data.getc();
    }
    return {JSON_ARRAY, end_pos.from_state(start_pos), element_count};
}

template <typename T>
inline JsonNode json_consume_string(T& data) {
    data.getc();
    typename T::state_type start_pos = data.current();
    while (data.peek() != JSON_QUOTE) {
        char32_t code = read_unicode(data);
        if (code == UNICODE_INVALID) {
            return json_error(start_pos, "Illegal value in string");
        }
    }
    auto res = JsonNode(JSON_STRING, data.from_state(start_pos));
    data.getc();
    return res;
}

inline bool
string_to_double_in_string_sequence(std::string_view text, double& value, int* end_ptr) {
    bool result = true;  // Assume all will be well.
    value = 0.0;
    std::istringstream iss((std::string(text)));
    iss.imbue(std::locale::classic());  // Force locale
    iss >> value;
    if (end_ptr != nullptr) {
        if (iss.eof(
            ))  // In VS2010 tellg() may not return -1 at eof so we check the eof flag instead.
        {
            *end_ptr = -1;
        } else {
            *end_ptr = static_cast<int>(iss.tellg());
        }
    }
    // Note: The failbit flag can be set at eof, specifically check that if
    // failbit is set that eof bit is NOT set.
    if ((iss.fail() && !(iss.eof())) || iss.bad()) {
        result = false;
    }
    return result;
}

inline std::string stdprintf(const char* format, ...) {
    va_list ap;
    va_start(ap, format);
    auto len = std::vsnprintf(nullptr, 0, format, ap);
    va_end(ap);
    if (len < 0) {
        throw std::runtime_error("Invalid format string passed to vsnprintf");
    }
    std::vector<char> vec(len + 1);
    va_start(ap, format);
    std::vsnprintf(vec.data(), len + 1, format, ap);
    va_end(ap);
    return vec.data();
}
}  // namespace detail

inline char32_t JsonData::read_unicode() {
    return detail::read_unicode(*this);
}

inline JsonNode JsonNode::from_data(std::string_view str) {
    JsonData data(str.data(), str.length());
    return detail::json_parse(data);
}

inline JsonNode JsonNode::from_data(JsonData& data) {
    return detail::json_parse(data);
}

inline JsonNode JsonNode::from_data(JsonStream& data) {
    return detail::json_parse(data);
}

inline bool JsonNode::get_array(std::vector<JsonNode>& value) const {
    if (m_type == JSON_ARRAY) {
        JsonData data(m_data);
        if (m_value_count > 0) {
            value.push_back(detail::json_parse(data));
        }
        for (size_t i = 1; i < m_value_count; ++i) {
            detail::json_consume_separator(data, detail::JSON_COMMA);
            value.push_back(detail::json_parse(data));
        }
        return true;
    }
    if (m_type == JSON_OBJECT) {
        JsonData data(m_data);
        for (size_t i = 0; i < m_value_count; ++i) {
            if (i != 0) {
                detail::json_consume_separator(data, detail::JSON_COMMA);
            }
            value.push_back(detail::json_parse(data));
            detail::json_consume_separator(data, detail::JSON_COLON);
            value.push_back(detail::json_parse(data));
        }
        return true;
    }
    return false;
}

inline bool JsonNode::get_object(std::map<std::string, JsonNode>& value) const {
    if (m_type == JSON_OBJECT) {
        JsonData data(m_data);
        for (size_t i = 0; i < m_value_count; ++i) {
            if (i != 0) {
                detail::json_consume_separator(data, detail::JSON_COMMA);
            }
            JsonNode key = detail::json_parse(data);
            detail::json_consume_separator(data, detail::JSON_COLON);
            JsonNode value_node = detail::json_parse(data);
            std::string key_string;
            if (key.get_string(key_string)) {
                value[key_string] = value_node;
            }
        }
        return true;
    }
    return false;
}

inline bool JsonNode::get_object(std::vector<std::pair<JsonNode, JsonNode>>& value) const {
    if (m_type == JSON_OBJECT) {
        JsonData data(m_data);
        for (size_t i = 0; i < m_value_count; ++i) {
            if (i != 0) {
                detail::json_consume_separator(data, detail::JSON_COMMA);
            }
            JsonNode key = detail::json_parse(data);
            detail::json_consume_separator(data, detail::JSON_COLON);
            JsonNode value_node = detail::json_parse(data);
            value.emplace_back(key, value_node);
        }
        return true;
    }
    return false;
}

inline bool JsonNode::get_object_as_vector(std::vector<JsonNode>& value) const {
    if (m_type == JSON_OBJECT) {
        JsonData data(m_data);
        for (size_t i = 0; i < m_value_count; ++i) {
            if (i != 0) {
                detail::json_consume_separator(data, detail::JSON_COMMA);
            }
            JsonNode key = detail::json_parse(data);
            detail::json_consume_separator(data, detail::JSON_COLON);
            JsonNode value_node = detail::json_parse(data);
            value.push_back(key);
            value.push_back(value_node);
        }
        return true;
    }
    return false;
}

inline bool JsonNode::get_bool(bool& value) const {
    if (m_type != JSON_BOOL) {
        return false;
    }
    value = m_type == JSON_BOOL && m_data.length() == 4;
    return true;
}

inline bool JsonNode::get_number(double& value) const {
    if (m_type != JSON_INTEGER && m_type != JSON_FLOAT) {
        return false;
    }
    return detail::string_to_double_in_string_sequence(m_data.str(), value, nullptr);
}

inline JsonWriter::JsonWriter(
    std::ostream& out,
    SerializerFlags flags,
    int indent_step,
    int indent_level
)
    : m_out(out), m_flags(flags), m_indentStep(indent_step), m_indentLevel(indent_level) {}

inline JsonWriter::JsonWriter(std::ostream& out, bool pretty, int indent_step, int indent_level)
    : m_out(out),
      m_flags(pretty ? SERIALIZER_PRETTY : SerializerFlagsBits{}),
      m_indentStep(indent_step),
      m_indentLevel(indent_level) {}

inline void JsonWriter::reset(int indent_level) {
    m_indentLevel = indent_level;
    m_needComma = false;
}

inline void JsonWriter::start_object() {
    maybe_comma();
    put('{');
    newline();
    ++m_indentLevel;
    m_needComma = false;
}

inline void JsonWriter::end_object() {
    --m_indentLevel;
    if (m_needComma) {
        newline();
    }
    put('}');
    m_needComma = true;
}

inline void JsonWriter::start_array() {
    maybe_comma();
    put('[');
    newline();
    ++m_indentLevel;
    m_needComma = false;
}

inline void JsonWriter::end_array() {
    --m_indentLevel;
    if (m_needComma) {
        newline();
    }
    put(']');
    m_needComma = true;
}

inline std::ostream& JsonWriter::stream() {
    return m_type_stack[m_level].tmp_out ? *m_type_stack[m_level].tmp_out : m_out;
}

inline void JsonWriter::write(bool value) {
    maybe_comma();
    if (value) {
        put('t');
        put('r');
        put('u');
        put('e');
    } else {
        put('f');
        put('a');
        put('l');
        put('s');
        put('e');
    }
    m_needComma = true;
}

inline void JsonWriter::write_null() {
    maybe_comma();
    put('n');
    put('u');
    put('l');
    put('l');
    m_needComma = true;
}

#define NUM_WRITER(type, format)                                                    \
    inline void JsonWriter::write(type value) {                                     \
        maybe_comma();                                                              \
        if (std::isnan(value) || std::isinf(value)) {                               \
            write_null();                                                           \
        } else {                                                                    \
            auto formatted = detail::stdprintf(format, static_cast<double>(value)); \
            for (auto c : formatted) put(c);                                        \
            m_needComma = true;                                                     \
        }                                                                           \
    }

NUM_WRITER(float, "%.7e");

NUM_WRITER(double, "%.16e");

inline void JsonWriter::write_string(const std::string& value) {
    maybe_comma();
    put('"');
    const char* str = value.c_str();
    while (*str) {
        char32_t code = 0;
        str += read_char_code<UTF8>(code, str);
        char buf[4];
        int len = write_char_code<DEFAULT_ENCODING>(buf, code);
        if (len == 1) {
            put_escaped(buf[0]);
        } else {
            for (int i = 0; i < len; ++i) {
                put(buf[i]);
            }
        }
    }
    put('"');
    m_needComma = true;
}

inline void JsonWriter::write_string(const std::u16string& value) {
    maybe_comma();
    put('"');
    const char16_t* str = value.c_str();
    while (*str) {
        char32_t code = 0;
        str += read_char_code(code, str);
        char buf[4];
        int len = write_char_code<UTF8>(buf, code);
        if (len == 1) {
            put_escaped(buf[0]);
        } else {
            for (int i = 0; i < len; ++i) {
                put(buf[i]);
            }
        }
    }
    put('"');
    m_needComma = true;
}

inline void JsonWriter::write_string(const std::wstring& value) {
    maybe_comma();
    put('"');
    const wchar_t* str = value.c_str();
    while (*str) {
        char32_t code = 0;
        str += read_char_code(code, str);
        char buf[4];
        int len = write_char_code<UTF8>(buf, code);
        if (len == 1) {
            put_escaped(buf[0]);
        } else {
            for (int i = 0; i < len; ++i) {
                put(buf[i]);
            }
        }
    }
    put('"');
    m_needComma = true;
}

inline void JsonWriter::write(long double value) {
    write(static_cast<double>(value));
}

inline void JsonWriter::write(unsigned char value) {
    write_unsigned(value);
}

inline void JsonWriter::write(char value) {
    std::string str;
    str.resize(1);
    str[0] = value;
    write_string(str);
}

inline void JsonWriter::write(uint16_t value) {
    write_unsigned(value);
}

inline void JsonWriter::write(int16_t value) {
    write_integer(value);
}

inline void JsonWriter::write(uint32_t value) {
    write_unsigned(value);
}

inline void JsonWriter::write(int32_t value) {
    write_integer(value);
}

inline void JsonWriter::write(uint64_t value) {
    write_unsigned(value);
}

inline void JsonWriter::write(int64_t value) {
    write_integer(value);
}

inline void JsonWriter::write(const JsonNode& node) {
    switch (node.get_type()) {
    case JSON_FLOAT: {
        double value;
        if (node.get_number(value)) {
            write(value);
        }
        break;
    }
    case JSON_INTEGER: {
        int64_t value;
        if (node.get_integer(value)) {
            write(value);
        }
        break;
    }
    case JSON_STRING: {
        std::string value;
        if (node.get_string(value)) {
            write_string(value);
        }
        break;
    }
    case JSON_ARRAY: {
        std::vector<JsonNode> nodes;
        if (node.get_array(nodes)) {
            start_array();
            {
                for (auto& n : nodes) {
                    write(n);
                }
            }
            end_array();
        }
        break;
    }
    case JSON_OBJECT: {
        std::vector<JsonNode> nodes;
        std::string key_string;
        if (node.get_object_as_vector(nodes)) {
            start_object();
            for (auto it = nodes.begin(); it != nodes.end(); ++it) {
                if (it->get_string(key_string)) {
                    write_key(key_string);
                    ++it;
                    if (it != nodes.end()) {
                        write(*it);
                    }
                }
            }
        }
        end_object();
        break;
    }
    case JSON_BOOL: {
        bool value;
        if (node.get_bool(value)) {
            write(value);
        }
        break;
    }
    case JSON_NULL:
        write_null();
        break;
    case JSON_PARSE_ERROR:
        break;
    }
}

inline bool JsonWriter::is_pretty() const {
    return (m_flags & SERIALIZER_PRETTY) != 0;
}

inline void JsonWriter::set_pretty(bool pretty) {
    if (pretty) {
        m_flags |= SERIALIZER_PRETTY;
    } else {
        m_flags &= ~SERIALIZER_PRETTY;
    }
}

inline bool JsonWriter::is_key() const {
    const Stack& stack = m_type_stack[m_level];
    return stack.is_object && (stack.pos % 2) == 0;
}

inline void JsonWriter::maybe_comma() {
    Stack& stack = m_type_stack[m_level];
    if (m_needComma) {
        if (is_key()) {
            put(':');
            if (is_pretty()) {
                put(' ');
            }
        } else {
            put(',');
            newline();
        }
        stack.pos++;
        m_needComma = false;
        if (is_key()) {
            newline();
        }
    } else if (m_level > 0 && stack.pos == 0 &&
               (stack.info.kind == dcps::xtypes::TK_STRUCTURE ||
                stack.info.kind == dcps::xtypes::TK_UNION ||
                stack.info.kind == dcps::xtypes::TK_MAP ||
                stack.info.kind == dcps::xtypes::TK_ARRAY ||
                stack.info.kind == dcps::xtypes::TK_SEQUENCE)) {
        newline();
    }
}

inline void JsonWriter::newline() {
    if (is_pretty() && !m_is_new_line) {
        put('\n');
        m_is_new_line = true;
    }
}

inline void JsonWriter::put_escaped(char c) {
    switch (c) {
    case '\\':
        put('\\');
        put('\\');
        break;
    case '"':
        put('\\');
        put('"');
        break;
    case '\b':
        put('\\');
        put('b');
        break;
    case '\f':
        put('\\');
        put('f');
        break;
    case '\n':
        put('\\');
        put('n');
        break;
    case '\r':
        put('\\');
        put('r');
        break;
    case '\t':
        put('\\');
        put('t');
        break;
    default:
        if (c < 0x20) {
            put('\\');
            put('u');
            put('0');
            put('0');
            put(detail::hex_character(c >> 4));
            put(detail::hex_character(c & 0xf));
        } else {
            put(c);
        }
    }
}

inline void JsonWriter::put(char c) {
    if (is_pretty() && m_is_new_line) {  // Indent line before writing character
        for (uint32_t i = 0; i < m_indentLevel * m_indentStep; ++i) {
            stream().put(' ');
        }
        m_is_new_line = false;
    }
    stream().put(c);
}

inline void JsonWriter::begin_type(const TypeInfo& a_info) {
    if (m_level + 1 >= dcps::cts::MAX_NESTED_DEPTH) {
        throw std::runtime_error("Cannot serialize type, nesting too deep");
    }
    maybe_comma();
    bool is_object = false;
    switch (a_info.kind) {
    case dcps::xtypes::TK_STRUCTURE:
    case dcps::xtypes::TK_UNION:
        if (a_info.name != std::string_view("intercom::JsonValue")) {
            start_object();
        }
        is_object = true;
        break;
    case dcps::xtypes::TK_MAP:
        start_object();
        is_object = true;
        break;
    case dcps::xtypes::TK_SEQUENCE:
    case dcps::xtypes::TK_ARRAY:
        start_array();
        break;
    default:
        break;
    }
    ++m_level;
    m_type_stack[m_level].info = a_info;
    m_type_stack[m_level].is_object = is_object;
    m_type_stack[m_level].pos = 0;
    if (m_type_stack[m_level - 1].tmp_out || a_info.kind == dcps::xtypes::TK_UNION) {
        m_type_stack[m_level].tmp_out = std::make_unique<std::stringstream>();
        m_type_stack[m_level].tmp_is_new_line = m_is_new_line;
    }
}

inline void JsonWriter::end_type() {
    auto& stack = m_type_stack[m_level];
    --m_level;
    if (stack.tmp_out) {
        stream() << stack.tmp_out->str();
        stack.tmp_out.reset();
    }

    switch (stack.info.kind) {
    case dcps::xtypes::TK_STRUCTURE:
    case dcps::xtypes::TK_UNION:
        if (stack.info.name != std::string_view("intercom::JsonValue")) {
            end_object();
        }
        break;
    case dcps::xtypes::TK_MAP:
        end_object();
        break;
    case dcps::xtypes::TK_SEQUENCE:
    case dcps::xtypes::TK_ARRAY:
        end_array();
        break;
    default:
        break;
    }
    if (m_level == 0) {
        newline();
    }
}

inline uint32_t JsonWriter::type_level() {
    return m_level;
}

inline bool JsonWriter::is_relevant(const MemberInfo&) {
    return true;
}

inline bool JsonWriter::begin_member(const MemberInfo& a_member) {
    if (m_type_stack[m_level].info.kind == dcps::xtypes::TK_UNION) {
        if (a_member.name == std::string_view("_d")) {
            if (m_type_stack[m_level].info.name != std::string_view("intercom::JsonValue")) {
                write_key("$discriminator");
            } else {
                m_type_stack[m_level].pos++;
            }
        } else {
            if (a_member.case_labels && a_member.case_labels[0] == 1) {
                m_type_stack[m_level].tmp_out = std::make_unique<std::stringstream>();
                m_needComma = false;
                m_type_stack[m_level].pos = 0;
                m_is_new_line = m_type_stack[m_level].tmp_is_new_line;
            }
            if (m_type_stack[m_level].info.name != std::string_view("intercom::JsonValue")) {
                write_key(a_member.name);
            } else {
                m_type_stack[m_level].pos++;
            }
        }
    } else {
        write_key(a_member.name);
    }
    return true;
}

inline bool JsonWriter::begin_optional_member(const MemberInfo& a_member, bool a_present) {
    return a_present && begin_member(a_member);
}

inline void JsonWriter::end_member() {}

inline void JsonWriter::write_length(uint32_t) {}

inline void JsonWriter::write(const std::string& a_value) {
    write_string(a_value);
}

inline void JsonWriter::write(const std::wstring& a_value) {
    write_string(a_value);
}

inline void JsonWriter::write(const std::u16string& a_value) {
