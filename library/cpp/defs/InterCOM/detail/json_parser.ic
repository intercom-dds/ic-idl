template <typename T>
inline void JsonWriter::write_integer(T& a_value, const TypeInfo& a_info) {
    if (a_info.kind == intercom::dcps::xtypes::TK_ENUM ||
        a_info.kind == intercom::dcps::xtypes::TK_BITMASK) {
        std::string str;
        if (enum_to_string(str, a_value, &a_info)) {
            if (m_type_stack[m_level].info.name != nullptr &&
                m_type_stack[m_level].info.name == std::string_view("intercom::JsonValue") &&
                str == "JSON_VALUE_NULL") {
                write_null();
            } else {
                write_string(str);
            }
            return;
        }
    }
    maybe_comma();
    if (is_key()) {
        put('"');
        write(a_value);
        put('"');
    } else {
        write(a_value);
    }
}

inline SerializerFlags JsonWriter::flags() const {
    return m_flags;
}

inline void JsonReader::begin_type(const TypeInfo& a_info) {
    if (m_level >= dcps::cts::MAX_NESTED_DEPTH - 1) {
        throw std::runtime_error("Cannot deserialize type, nesting too deep");
    }
    JsonNode current = m_type_stack[m_level].current;
    ++m_level;
    m_type_stack[m_level].info = a_info;
    switch (a_info.kind) {
    case dcps::xtypes::TK_STRUCTURE:
        current.get_object(m_type_stack[m_level].current_map);
        break;
    case dcps::xtypes::TK_UNION:
        if (a_info.name != std::string_view("intercom::JsonValue")) {
            current.get_object(m_type_stack[m_level].current_map);
        } else {
            switch (current.get_type()) {
            case JSON_FLOAT:
                m_type_stack[m_level].current_map["float_value"] = current;
                break;
            case JSON_INTEGER:
                m_type_stack[m_level].current_map["integer_value"] = current;
                break;
            case JSON_STRING:
                m_type_stack[m_level].current_map["string_value"] = current;
                break;
            case JSON_ARRAY:
                m_type_stack[m_level].current_map["array_value"] = current;
                break;
            case JSON_OBJECT:
                m_type_stack[m_level].current_map["object_value"] = current;
                break;
            case JSON_BOOL:
                m_type_stack[m_level].current_map["bool_value"] = current;
                break;
            case JSON_NULL:
                m_type_stack[m_level].current_string = "JSON_VALUE_NULL";
                m_type_stack[m_level].current_map["_d"] =
                    JsonNode(JSON_STRING, m_type_stack[m_level].current_string);
                break;
            case JSON_PARSE_ERROR:
                throw std::runtime_error("Cannot deserialize type, no valid data");
            }
        }
        break;
    case dcps::xtypes::TK_SEQUENCE:
        if (current.get_type() != JSON_ARRAY) {
            // Expecting an array, interpret current non-array element as a vector with
            // length 1. This allows one-element sequences to be represented
            // as X instead of [ X ], which the DDS JSON standard allows in
            // some places.
            m_type_stack[m_level].current_vec.resize(1);
            m_type_stack[m_level].count = 0;
            m_type_stack[m_level].current = m_type_stack[m_level].current_vec[0] = current;
        } else {
            current.get_array(m_type_stack[m_level].current_vec);
            m_type_stack[m_level].count = 0;
            if (!m_type_stack[m_level].current_vec.empty()) {
                m_type_stack[m_level].current = m_type_stack[m_level].current_vec[0];
            }
        }
        break;
    case dcps::xtypes::TK_MAP:
        if (current.get_type() == JSON_OBJECT) {
            current.get_object_as_vector(m_type_stack[m_level].current_vec);
        } else {
            current.get_array(m_type_stack[m_level].current_vec);
        }
        m_type_stack[m_level].count = 0;
        if (!m_type_stack[m_level].current_vec.empty()) {
            m_type_stack[m_level].current = m_type_stack[m_level].current_vec[0];
        }
        break;
    case dcps::xtypes::TK_ARRAY:
        current.get_array(m_type_stack[m_level].current_vec);
        m_type_stack[m_level].count = 0;
        if (!m_type_stack[m_level].current_vec.empty()) {
            m_type_stack[m_level].current = m_type_stack[m_level].current_vec[0];
        }
        break;
    default:
        m_type_stack[m_level].current = current;
        break;
    }
}

inline void JsonReader::end_type() {
    auto& stack = m_type_stack[m_level];
    if ((m_flags & SERIALIZER_STRICT) != 0 &&
        stack.current_map.size() > stack.consumed_keys.size()) {
        std::stringstream missing;
        for (auto& value : stack.current_map) {
            if (stack.consumed_keys.find(value.first) == stack.consumed_keys.end()) {
                missing << value.first << " ";
            }
        }
        throw std::runtime_error("The following object values were not parsed: " + missing.str());
    }
    m_type_stack[m_level--] = {};
    m_type_stack[m_level].next_value();
}

inline uint32_t JsonReader::type_level() {
    return m_level;
}

inline bool JsonReader::find_member(const MemberInfo& a_member) {
    auto& stack = m_type_stack[m_level];
    auto it = stack.current_map.find(a_member.name);

    // For unions, lookup both "_d" and "$discriminator" for explicit discriminator.
    // If not found, see if the only key in the map matches a known member, and if so
    // add its case value as an implicit discriminator.
    if (it == stack.current_map.end() && stack.info.kind == dcps::xtypes::TK_UNION &&
        a_member.name == std::string_view("_d")) {
        it = stack.current_map.find("$discriminator");
        if (it == stack.current_map.end() && stack.current_map.size() == 1) {
            auto key = stack.current_map.begin()->first;
            for (uint32_t i = 0; i < stack.info.member_count; ++i) {
                if (stack.info.members[i].name == key && stack.info.members[i].case_labels) {
                    stack.current_string = std::to_string(stack.info.members[i].case_labels[1]);
                    stack.current = JsonNode(JSON_INTEGER, stack.current_string);
                    return true;
                }
            }
        }
    }
    if (it != stack.current_map.end()) {
        if ((m_flags & SERIALIZER_STRICT) != 0) {
            stack.consumed_keys.insert(it->first);
        }
        stack.current = it->second;
        return true;
    }

    if ((m_flags & SERIALIZER_STRICT) != 0) {
        throw std::runtime_error("Key '" + std::string(a_member.name) + "' not found");
    }

    return false;
}

inline bool JsonReader::can_skip_type() {
    return false;
}

inline uint32_t JsonReader::read_length() {
    Stack& stack = m_type_stack[m_level];
    if (stack.info.kind == dcps::xtypes::TK_MAP) {
        return static_cast<uint32_t>(stack.current_vec.size() / 2);
    }
    return static_cast<uint32_t>(stack.current_vec.size());
}

inline void JsonReader::read(std::string& a_value) {
    if (!m_type_stack[m_level].current.get_string(a_value)) {
        throw std::runtime_error("Cannot deserialize type, failed to read string");
    }
    m_type_stack[m_level].next_value();
}

inline void JsonReader::read(std::wstring& a_value) {
    if (!m_type_stack[m_level].current.get_string(a_value)) {
        throw std::runtime_error("Cannot deserialize type, failed to read string");
    }
    m_type_stack[m_level].next_value();
}

inline void JsonReader::read(std::u16string& a_value) {
    if (!m_type_stack[m_level].current.get_string(a_value)) {
        throw std::runtime_error("Cannot deserialize type, failed to read string");
    }
    m_type_stack[m_level].next_value();
}

inline void JsonReader::read(bool* a_values, uint32_t a_count, const TypeInfo&) {
    for (uint32_t i = 0; i < a_count; ++i) {
        if (!m_type_stack[m_level].current.get_bool(a_values[i])) {
            std::string str;
            int64_t int_val;
            if (m_type_stack[m_level].current.get_string(str)) {
                if (str == "true") {
                    a_values[i] = true;
                } else if (str == "false") {
                    a_values[i] = false;
                } else {
                    throw std::runtime_error(
                        "Cannot deserialize type, failed to read boolean from string"
                    );
                }
            } else if (m_type_stack[m_level].current.get_integer(int_val)) {
                if (int_val == 1) {
                    a_values[i] = true;
                } else if (int_val == 0) {
                    a_values[i] = false;
                } else {
                    throw std::runtime_error(
                        "Cannot deserialize type, failed to read boolean from integer"
                    );
                }
            } else {
                throw std::runtime_error("Cannot deserialize type, failed to read boolean");
            }
        }
        m_type_stack[m_level].next_value();
    }
}

inline void JsonReader::read(int8_t* a_values, uint32_t a_count, const TypeInfo& a_info) {
    for (uint32_t i = 0; i < a_count; ++i) {
        read_integer(a_values[i], a_info);
        m_type_stack[m_level].next_value();
    }
}

inline void JsonReader::read(uint8_t* a_values, uint32_t a_count, const TypeInfo& a_info) {
    for (uint32_t i = 0; i < a_count; ++i) {
        read_integer(a_values[i], a_info);
        m_type_stack[m_level].next_value();
    }
}

