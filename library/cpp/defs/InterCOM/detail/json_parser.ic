}

inline void JsonWriter::write(const bool* a_values, uint32_t a_count, const TypeInfo&) {
    maybe_comma();
    if (is_key() && a_count == 1) {
        put('"');
        write(a_values[0]);
        put('"');
    } else {
        for (uint32_t i = 0; i < a_count; ++i) {
            write(a_values[i]);
        }
    }
}

inline void JsonWriter::write(const int8_t* a_values, uint32_t a_count, const TypeInfo& a_info) {
    for (uint32_t i = 0; i < a_count; ++i) {
        write_integer(a_values[i], a_info);
    }
}

