inline void JsonReader::read(float* a_values, uint32_t a_count, const TypeInfo& a_info) {
    for (uint32_t i = 0; i < a_count; ++i) {
        double x;
        if (!m_type_stack[m_level].current.get_number(x) && !read_from_string(x, a_info)) {
            throw std::runtime_error("Cannot deserialize type, failed to read float");
        }
        a_values[i] = static_cast<float>(x);
        m_type_stack[m_level].next_value();
    }
}

inline void JsonReader::read(double* a_values, uint32_t a_count, const TypeInfo& a_info) {
    for (uint32_t i = 0; i < a_count; ++i) {
        if (!m_type_stack[m_level].current.get_number(a_values[i]) &&
            !read_from_string(a_values[i], a_info)) {
            throw std::runtime_error("Cannot deserialize type, failed to read float");
        }
        m_type_stack[m_level].next_value();
    }
}

inline void JsonReader::read(long double* a_values, uint32_t a_count, const TypeInfo& a_info) {
    for (uint32_t i = 0; i < a_count; ++i) {
        double x;
        if (!m_type_stack[m_level].current.get_number(x) && !read_from_string(x, a_info)) {
            throw std::runtime_error("Cannot deserialize type, failed to read float");
        }
        a_values[i] = x;
        m_type_stack[m_level].next_value();
    }
}

inline void JsonReader::read(char* a_values, uint32_t a_count, const TypeInfo&) {
    for (uint32_t i = 0; i < a_count; ++i) {
        std::string str;
        read(str);
        a_values[i] = str[0];
    }
}

inline void JsonReader::read(char16_t* a_values, uint32_t a_count, const TypeInfo&) {
    for (uint32_t i = 0; i < a_count; ++i) {
        std::u16string str;
        read(str);
        a_values[i] = str[0];
    }
}

inline void JsonWriter::write(const char* a_values, uint32_t a_count, const TypeInfo&) {
    std::string str;
    str.reserve(1);
    for (uint32_t i = 0; i < a_count; ++i) {
        str[0] = a_values[i];
        write(str);
    }
}

inline void JsonWriter::write(const char16_t* a_values, uint32_t a_count, const TypeInfo&) {
    std::u16string str;
    str.reserve(1);
    for (uint32_t i = 0; i < a_count; ++i) {
        str[0] = a_values[i];
        write(str);
    }
}

template <typename T>
inline bool JsonReader::read_from_string(T& a_value, const TypeInfo&) {
    JsonNode current_node = m_type_stack[m_level].current;
    if (current_node.get_type() == JSON_STRING) {
        std::string str;
        try {
            if (current_node.get_string(str)) {
                // Lookup const value
                auto it = m_const_map.find(str);
                if (it != m_const_map.end()) {
                    JsonReader reader(it->second);
                    dcps::cts::GenericUnmarshal(reader).io(a_value);
                    return true;
                }
                // Attempt to parse string as integer
                JsonReader reader(str.c_str(), static_cast<uint32_t>(str.size()));
                reader.m_const_map = m_const_map;
                dcps::cts::GenericUnmarshal(reader).io(a_value);
                return true;
            }
        } catch (...) {  // NOLINT
        }
    }
    return false;
}

template <typename T>
inline void JsonReader::read_integer(T& a_value, const TypeInfo& a_info) {
    JsonNode current_node = m_type_stack[m_level].current;
    if (current_node.get_integer(a_value)) {
        return;
    }
    // if (a_info.kind == intercom::dcps::xtypes::TK_ENUM ||
    //     a_info.kind == intercom::dcps::xtypes::TK_BITMASK) {
    //     corba::String_var str;
    //     Uint64_t uval;
    //     if (current_node.get_string(str) && stringToEnum(uval, str.c_str(), &a_info)) {
    //         a_value = static_cast<T>(uval);
    //         return;
    //     }
    //     throw std::runtime_error("Unknown enumeration value in json unmarshal");
    // }
    if (read_from_string(a_value, a_info)) {
        return;
    }
    throw std::runtime_error("Failed to read integer value");
}

inline JsonReader::JsonReader(std::string_view a_text, SerializerFlags a_flags)
    : JsonReader(a_text.data(), static_cast<uint32_t>(a_text.length()), a_flags) {}

inline JsonReader::JsonReader(const char* a_text, uint32_t a_length, SerializerFlags a_flags)
    : m_data(new JsonData(a_text, a_length)), m_flags(a_flags) {
    m_type_stack[0].current = JsonNode::from_data(*m_data);
    m_type_stack[0].info = NULL_TYPE_INFO;
    if (m_type_stack[0].current.get_type() == JSON_PARSE_ERROR) {
        throw std::runtime_error("Invalid JSON data supplied to JsonReader");
    }
}

inline JsonReader::JsonReader(std::istream& a_stream, SerializerFlags a_flags)
    : m_stream(new JsonStream(a_stream)), m_flags(a_flags) {
    m_type_stack[0].current = JsonNode::from_data(*m_stream);
    m_type_stack[0].info = NULL_TYPE_INFO;
    if (m_type_stack[0].current.get_type() == JSON_PARSE_ERROR) {
        throw std::runtime_error("Invalid JSON data supplied to JsonReader");
    }
}

inline JsonReader::JsonReader(const JsonNode& a_node, SerializerFlags a_flags) : m_flags(a_flags) {
    m_type_stack[0].current = a_node;
    m_type_stack[0].info = NULL_TYPE_INFO;
    if (m_type_stack[0].current.get_type() == JSON_PARSE_ERROR) {
        throw std::runtime_error("Invalid JSON data supplied to JsonReader");
    }
}

inline void JsonReader::end_member() {}

inline SerializerFlags JsonReader::flags() const {
    return m_flags;
}

inline void JsonReader::add_const_value(const std::string& a_name, const JsonNode& a_value) {
    m_const_map[a_name] = a_value;
}

inline void JsonReader::Stack::next_value() {
    if (count + 1 < current_vec.size()) {
        current = current_vec[++count];
    } else {
        current = JsonNode();
    }
}
}  // namespace intercom
