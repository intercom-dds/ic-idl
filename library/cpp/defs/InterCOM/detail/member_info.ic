const Long* MemberInfo_empty_case_labels = {nullptr};

const TypeInfo TypeTraits<bool>::type_info = Boolean_type_info;
const TypeInfo TypeTraits<char>::type_info = Char_type_info;
const TypeInfo TypeTraits<char16_t>::type_info = Char16_type_info;
const TypeInfo TypeTraits<char32_t>::type_info = Char32_type_info;
const TypeInfo TypeTraits<int8_t>::type_info = Int8_type_info;
const TypeInfo TypeTraits<uint8_t>::type_info = Uint8_type_info;
const TypeInfo TypeTraits<int16_t>::type_info = Short_type_info;
const TypeInfo TypeTraits<uint16_t>::type_info = UShort_type_info;
const TypeInfo TypeTraits<int32_t>::type_info = Long_type_info;
const TypeInfo TypeTraits<uint32_t>::type_info = ULong_type_info;
const TypeInfo TypeTraits<int64_t>::type_info = LongLong_type_info;
const TypeInfo TypeTraits<uint64_t>::type_info = ULongLong_type_info;
const TypeInfo TypeTraits<float>::type_info = Float_type_info;
const TypeInfo TypeTraits<double>::type_info = Double_type_info;
const TypeInfo TypeTraits<long double>::type_info = LongDouble_type_info;

void TypeInfoDeleter::operator()(const TypeInfo* info) {
    for (ULong i = 0; i < info->member_count; ++i) {
        corba::string_free(info->members[i].name);
        corba::string_free(info->members[i].default_value);
        if (info->members[i].case_labels &&
            info->members[i].case_labels != MemberInfo_empty_case_labels) {
            lib_free(const_cast<Long*>(info->members[i].case_labels));
        }
    }
    lib_free(info->min_value);
    lib_free(info->max_value);
    lib_free(info->default_value);
    lib_free(info->members);
    corba::string_free(info->name);
    delete info;
}

}  // namespace intercom
