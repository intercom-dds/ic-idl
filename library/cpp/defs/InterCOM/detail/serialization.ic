namespace intercom {

template <typename T>
inline bool enumToString(std::string& res, T value, const TypeInfo* type) {
    if (type) {
        if (type->kind == dcps::xtypes::TK_ENUM) {
            auto uvalue = static_cast<ULong>(value);
            if (uvalue < type->member_count && type->members[uvalue].id == uvalue) {
                res = type->members[uvalue].name;
                return true;
            }
            for (ULong i = 0; i < type->member_count; ++i) {
                if (uvalue == type->members[i].id) {
                    res = type->members[i].name;
                    return true;
                }
            }
        } else if (type->kind == dcps::xtypes::TK_BITMASK) {
            std::ostringstream stream;
            bool empty = true;
            for (ULong i = 0; i < type->member_count; ++i) {
                if ((1ULL << type->members[i].id) & value) {
                    if (!empty) {
                        stream << "|";
                    }
                    stream << type->members[i].name;
                    value &= ~(1ULL << type->members[i].id);
                    empty = false;
                }
            }
            if (value == 0) {
                res = stream.str();
                return true;
            }
        }
    }
    return false;
}

template <typename T>
inline bool stringToEnum(T& value, const char* string, const TypeInfo* type) {
    if (type) {
        if (type->kind == dcps::xtypes::TK_ENUM) {
            for (ULong i = 0; i < type->member_count; ++i) {
                if (strcmp(string, type->members[i].name) == 0) {
                    value = static_cast<T>(type->members[i].id);
                    return true;
                }
            }
        } else if (type->kind == dcps::xtypes::TK_BITMASK) {
            bool res = true;
            ULongLong uvalue = 0;
            corba::String_var copy = string;
            char* ptr = copy.inout();
            while (ptr) {
                char* end = ptr;
                while (*end && *end != '|' && *end != ' ') {
                    ++end;
                }
                char* next = *end ? end + 1 : nullptr;
                *end = '\0';
                if (ptr != end) {
                    bool found = false;
                    for (ULong i = 0; i < type->member_count; ++i) {
                        if (strcmp(ptr, type->members[i].name) == 0) {
                            uvalue |= (1ULL << type->members[i].id);
                            found = true;
                            break;
                        }
                    }
                    if (!found) {
                        res = false;
                    }
                }
                ptr = next;
            }
            if (res) {
                value = static_cast<T>(uvalue);
            }
            return res;
        }
    }
    return false;
}

#define CTS_DEFINE_PRIMITIVE_TYPE(type)                                                          \
    template <class Archive>                                                                     \
    struct Serializer<Archive, type> {                                                           \
        void operator()(Archive& a, type& value, const TypeInfo* type_info) {                    \
            a.primitive_io(value, type_info);                                                    \
            if (Archive::IS_READER && type_info &&                                               \
                (type_info->flags & (dcps::xtypes::IS_USE_DEFAULT_TRY_CONSTRUCT |                \
                                     dcps::xtypes::IS_DISCARD_TRY_CONSTRUCT)) != 0) {            \
                if (type_info->min_value) {                                                      \
                    if (value < *static_cast<type*>(type_info->min_value)) {                     \
                        if (type_info->flags & dcps::xtypes::IS_USE_DEFAULT_TRY_CONSTRUCT) {     \
                            if (type_info->default_value) {                                      \
                                value = *static_cast<type*>(type_info->default_value);           \
                            } else {                                                             \
                                value = type();                                                  \
                            }                                                                    \
                        } else {                                                                 \
                            throw std::runtime_error("Value below minimum value");               \
                        }                                                                        \
                    }                                                                            \
                }                                                                                \
                if (type_info->max_value) {                                                      \
                    if (value > *static_cast<type*>(type_info->max_value)) {                     \
                        if (type_info->flags & dcps::xtypes::IS_USE_DEFAULT_TRY_CONSTRUCT) {     \
                            if (type_info->default_value) {                                      \
                                value = *static_cast<type*>(type_info->default_value);           \
                            } else {                                                             \
                                value = type();                                                  \
                            }                                                                    \
                        } else {                                                                 \
                            throw std::runtime_error("Value above maximum value");               \
                        }                                                                        \
                    }                                                                            \
                }                                                                                \
            }                                                                                    \
        }                                                                                        \
    };                                                                                           \
    template <class Archive>                                                                     \
    struct Serializer<Archive, type*> {                                                          \
        void operator()(Archive& a, type* value, ULong count, const TypeInfo* type_info) {       \
            a.primitive_io(value, count, type_info);                                             \
            if (Archive::IS_READER && type_info &&                                               \
                (type_info->flags & (dcps::xtypes::IS_USE_DEFAULT_TRY_CONSTRUCT |                \
                                     dcps::xtypes::IS_DISCARD_TRY_CONSTRUCT)) != 0) {            \
                if (type_info->min_value) {                                                      \
                    for (ULong i = 0; i < count; ++i) {                                          \
                        if (value[i] < *static_cast<type*>(type_info->min_value)) {              \
                            if (type_info->flags & dcps::xtypes::IS_USE_DEFAULT_TRY_CONSTRUCT) { \
                                if (type_info->default_value) {                                  \
                                    value[i] = *static_cast<type*>(type_info->default_value);    \
                                } else {                                                         \
                                    value[i] = type();                                           \
                                }                                                                \
                            } else {                                                             \
                                throw std::runtime_error("Value below minimum value");           \
                            }                                                                    \
                        }                                                                        \
                    }                                                                            \
                }                                                                                \
                if (type_info->max_value) {                                                      \
                    for (ULong i = 0; i < count; ++i) {                                          \
                        if (value[i] > *static_cast<type*>(type_info->max_value)) {              \
                            if (type_info->flags & dcps::xtypes::IS_USE_DEFAULT_TRY_CONSTRUCT) { \
                                if (type_info->default_value) {                                  \
                                    value[i] = *static_cast<type*>(type_info->default_value);    \
                                } else {                                                         \
                                    value[i] = type();                                           \
                                }                                                                \
                            } else {                                                             \
                                throw std::runtime_error("Value above maximum value");           \
                            }                                                                    \
                        }                                                                        \
                    }                                                                            \
                }                                                                                \
            }                                                                                    \
        }                                                                                        \
    };  // end of CTS_DEFINE_PRIMITIVE_TYPE

template <class Archive, typename T>
struct Serializer<Archive, T*> {
    void operator()(Archive& a, T* value, ULong count, const TypeInfo* type_info) {
        Serializer<Archive, T> serialize;
        for (ULong i = 0; i < count; ++i) {
            serialize(a, value[i], type_info);
        }
    }
    void operator()(Archive& a, T*& value, const TypeInfo*) {
        dcps::ReferableEntity::handle_t handle =
            Archive::IS_WRITER && value ? value->handle() : HANDLE_NIL_NATIVE;
        a.io(handle);
        if (Archive::IS_READER) {
            value = handle != HANDLE_NIL_NATIVE
                        ? dynamic_cast<T*>(dcps::ReferableEntity::get(handle))
                        : nullptr;
            if (value == nullptr && handle != HANDLE_NIL_NATIVE) {
                throw std::runtime_error("Invalid handle while reading CDR data");
            }
        }
    }
};

template <class Archive>
struct Serializer<Archive, std::string> {
    void operator()(Archive& a, std::string& value, const TypeInfo* type_info) {
        typename Archive::template StringValue<DEFAULT_ENCODING> serializer(a, type_info);
        serializer.io(value);
        if (type_info && type_info->max_length > 0 && value.size() > type_info->max_length) {
            if (type_info->flags & dcps::xtypes::IS_TRIM_TRY_CONSTRUCT) {
                value.resize(type_info->max_length);
            } else if (type_info->flags & dcps::xtypes::IS_USE_DEFAULT_TRY_CONSTRUCT) {
                if (type_info->default_value) {
                    value = static_cast<std::string::value_type*>(type_info->default_value);
                } else {
                    value.clear();
                }
            } else {
                throw std::runtime_error("String length out of bounds");
            }
        }
    }
};

template <class Archive, typename CharT, uint32_t N>
struct Serializer<Archive, intercom::bounded_basic_string<CharT, N>> {
    void operator()(Archive& a, std::basic_string<CharT>& value, const TypeInfo* type_info) {
        Serializer<Archive, std::basic_string<CharT>> serializer;
        serializer(a, value, type_info);
    }
};

