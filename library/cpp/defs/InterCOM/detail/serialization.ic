template <typename READER, typename UNMARSHAL>
inline TGenericUnmarshalBase<READER, UNMARSHAL>::StructValue::StructValue(
    UNMARSHAL& a_unmarshal,
    const TypeInfo* a_info
)
    : m_unmarshal(a_unmarshal), m_type_info(a_info ? *a_info : Null_type_info) {
    m_unmarshal.reader().begin_type(m_type_info);
}

template <typename READER, typename UNMARSHAL>
inline TGenericUnmarshalBase<READER, UNMARSHAL>::StructValue::~StructValue() {
    try {
        m_unmarshal.reader().end_type();
    } catch (...) {
        // If the data is bad, we are probably already in an exception, so
        // propagating another from here will cause the application to terminate
    }
}

template <typename READER, typename UNMARSHAL>
template <typename T>
inline void TGenericUnmarshalBase<READER, UNMARSHAL>::StructValue::io(
    const MemberInfo& a_member_info,
    T& value
) {
    if (skip_member(a_member_info)) {
        return;
    }
    if (m_unmarshal.reader().find_member(a_member_info)) {
        Serializer<UNMARSHAL, T> serialize;
        serialize(m_unmarshal, value, a_member_info.type);
        m_unmarshal.reader().end_member();
    } else if ((m_unmarshal.reader().flags() & SERIALIZER_SKIP_MISSING) == 0) {
        if (a_member_info.default_value) {
            JsonReader reader(
                a_member_info.default_value, static_cast<ULong>(strlen(a_member_info.default_value))
            );
            dcps::cts::GenericUnmarshal(reader).io(value);
        } else {
            EmptyUnmarshal empty;
            Serializer<EmptyUnmarshal, T> serialize;
            serialize(empty, value, a_member_info.type);
        }
    }
}

template <typename READER, typename UNMARSHAL>
template <typename T>
inline void TGenericUnmarshalBase<READER, UNMARSHAL>::StructValue::io(
    const MemberInfo& a_member_info,
    optional<T>& value
) {
    if (skip_member(a_member_info)) {
        return;
    }
    if (m_unmarshal.reader().find_member(a_member_info)) {
        Serializer<UNMARSHAL, T> serialize;
        if (!value.has_value()) {
            value = T();
        }
        try {
            serialize(m_unmarshal, *value, a_member_info.type);
        } catch (std::runtime_error&) {
            value.reset();
        }
        m_unmarshal.reader().end_member();
    } else {
        value.reset();
    }
}

template <typename READER, typename UNMARSHAL>
template <typename T>
inline void TGenericUnmarshalBase<READER, UNMARSHAL>::io(T& value, const TypeInfo* a_type_info) {
    Serializer<UNMARSHAL, T> serialize;
    serialize(*static_cast<UNMARSHAL*>(this), value, a_type_info);
}

template <typename WRITER, typename MARSHAL>
template <typename T>
inline void TGenericMarshalBase<WRITER, MARSHAL>::io(const T& value, const TypeInfo* a_type_info) {
    Serializer<MARSHAL, T> serialize;
    serialize(*static_cast<MARSHAL*>(this), *const_cast<T*>(&value), a_type_info);
}

template <typename T, typename WRITER, typename READER>
inline T copyValue(WRITER& writer, READER& reader, const TypeInfo& type_info) {
    T value = 0;
    reader.read(&value, 1, type_info);
    writer.write(&value, 1, type_info);
    return value;
}

template <typename WRITER, typename READER>
inline ULongLong copyPrimitive(WRITER& writer, READER& reader, const TypeInfo& type_info) {
    if (type_info.bit_size == 0 || type_info.bit_size > 64) {
        throw std::runtime_error("Invalid primitive size");
    } else if (type_info.bit_size <= 8) {
        return copyValue<Octet>(writer, reader, type_info);
    } else if (type_info.bit_size <= 16) {
        return copyValue<UShort>(writer, reader, type_info);
    } else if (type_info.bit_size <= 32) {
        return copyValue<ULong>(writer, reader, type_info);
    } else {
        return copyValue<ULongLong>(writer, reader, type_info);
    }
}

template <typename WRITER, typename READER>
inline bool
copyDiscriminator(WRITER& writer, READER& reader, const TypeInfo& type_info, dcps::Long& a_idx) {
    const MemberInfo* member_info = &type_info.members[0];
    ULongLong discr;
    bool reader_has_member = reader.find_member(*member_info);
    if (reader_has_member) {
        if (writer.begin_member(*member_info)) {
            discr = copyPrimitive(writer, reader, *member_info->type);
            writer.end_member();
        } else {
            EmptyWriter emptyWriter;
            discr = copyPrimitive(emptyWriter, reader, *member_info->type);
        }
        reader.end_member();
    } else {
        discr = type_info.member_count != 0 ? type_info.members[1].case_labels[0] : 0;
        for (ULong i = 1; i < type_info.member_count; ++i) {
            if ((type_info.members[i].flags & dcps::xtypes::IS_DEFAULT) != 0) {
                discr = type_info.members[i].case_labels[0];
                break;
            }
        }
        if (writer.begin_member(*member_info)) {
            if (type_info.bit_size == 0 || type_info.bit_size > 64) {
                throw std::runtime_error("Invalid primitive size");
            } else if (type_info.bit_size <= 8) {
                auto value = static_cast<Octet>(discr);
                writer.write(&value, 1, type_info);
            } else if (type_info.bit_size <= 16) {
                auto value = static_cast<UShort>(discr);
                writer.write(&value, 1, type_info);
            } else if (type_info.bit_size <= 32) {
                auto value = static_cast<ULong>(discr);
                writer.write(&value, 1, type_info);
            } else {
                auto value = static_cast<ULongLong>(discr);
                writer.write(&value, 1, type_info);
            }
            writer.end_member();
        }
    }
    int default_member = 0;
    a_idx = 0;
    for (ULong i = 1; a_idx == 0 && i < type_info.member_count; ++i) {
        if ((type_info.members[i].flags & dcps::xtypes::IS_DEFAULT) != 0) {
            default_member = i;
        }
        for (Long j = 0; j < type_info.members[i].case_labels[0]; ++j) {
            if (discr == static_cast<ULongLong>(type_info.members[i].case_labels[j + 1])) {
                a_idx = i;
                break;
            }
        }
    }
    if (a_idx == 0 && default_member > 0) {
        a_idx = default_member;
    }
    return reader_has_member;
}

template <typename WRITER, typename READER>
inline void copyMember(WRITER& writer, READER& reader, const MemberInfo& member_info) {
    const bool is_optional = (member_info.flags & dcps::xtypes::IS_OPTIONAL) != 0;

    if (reader.find_member(member_info)) {
        bool copied = false;
        if (is_optional) {
            if (writer.begin_optional_member(member_info, true)) {
                transform(writer, reader, *member_info.type);
                writer.end_member();
                copied = true;
            }
        } else {
            if (writer.begin_member(member_info)) {
                transform(writer, reader, *member_info.type);
                writer.end_member();
                copied = true;
            }
        }
        if (!copied && !reader.can_skip_type()) {
            intercom::dcps::cts::EmptyWriter emptyWriter;
            emptyWriter.begin_member(member_info);
            transform(emptyWriter, reader, *member_info.type);
            emptyWriter.end_member();
        }
        reader.end_member();
    } else {
        if (is_optional) {
            if (writer.begin_optional_member(member_info, false)) {
                writer.end_member();
            }
        } else {
            if (writer.begin_member(member_info)) {
                if (member_info.default_value) {
                    JsonReader jsonReader(
                        member_info.default_value,
                        static_cast<ULong>(strlen(member_info.default_value))
                    );
                    transform(writer, jsonReader, *member_info.type);
                } else {
                    intercom::dcps::cts::EmptyReader emptyReader;
                    transform(writer, emptyReader, *member_info.type);
                }
                writer.end_member();
            }
        }
    }
}

template <typename WRITER, typename READER>
inline void copyUnion(WRITER& writer, READER& reader, const TypeInfo& type_info) {
    Long idx;
    bool reader_has_value = copyDiscriminator(writer, reader, type_info, idx);
    if (idx > 0) {
        if (reader_has_value) {
            copyMember(writer, reader, type_info.members[idx]);
        } else {
            EmptyReader emptyReader(false);
            copyMember(writer, emptyReader, type_info.members[idx]);
        }
    }
}

template <typename WRITER, typename READER>
inline void copyStruct(WRITER& writer, READER& reader, const TypeInfo& type_info) {
    ULong last_member = type_info.member_count;
    if (reader.type_level() <= 1 && writer.type_level() <= 1) {
        while (last_member > 0 && !writer.is_relevant(type_info.members[last_member - 1])) {
            --last_member;
        }
    }
    for (ULong i = 0; i < last_member; ++i) {
        copyMember(writer, reader, type_info.members[i]);
    }
}

template <typename WRITER, typename READER>
inline void copyString8(WRITER& writer, READER& reader, const TypeInfo&) {
    std::string str;
    reader.read(str);
    writer.write(str);
}

template <typename WRITER, typename READER>
inline void copyString16(WRITER& writer, READER& reader, const TypeInfo&) {
    std::wstring str;
    reader.read(str);
    writer.write(str);
}

template <typename WRITER, typename READER>
inline void copyMap(WRITER& writer, READER& reader, const TypeInfo& type_info) {
    auto length = reader.read_length();
    writer.write_length(length);
    for (ULong i = 0; i < length; ++i) {
        transform(writer, reader, *type_info.key_type);
        transform(writer, reader, *type_info.element_type);
    }
}

template <typename WRITER, typename READER>
inline void copySequence(WRITER& writer, READER& reader, const TypeInfo& type_info) {
    auto length = reader.read_length();
    writer.write_length(length);
    for (ULong i = 0; i < length; ++i) {
        transform(writer, reader, *type_info.element_type);
    }
}

template <typename T, typename WRITER, typename READER>
inline void transform(WRITER& writer, READER& reader) {
    transform(writer, reader, TypeTraits<T>::type_info);
}

template <typename WRITER, typename READER>
inline void transform(WRITER& writer, READER& reader, const TypeInfo& type_info) {
    // Primitive types are handle without begin_type/end_type
    switch (type_info.kind) {
    case dcps::xtypes::TK_BOOLEAN:
        copyValue<Boolean>(writer, reader, Boolean_type_info);
        return;
    case dcps::xtypes::TK_BYTE:
        copyValue<Octet>(writer, reader, Octet_type_info);
        return;
    case dcps::xtypes::TK_CHAR8:
        copyValue<Char>(writer, reader, Char_type_info);
        return;
    case dcps::xtypes::TK_INT8:
        copyValue<Int8>(writer, reader, Int8_type_info);
        return;
    case dcps::xtypes::TK_UINT8:
        copyValue<Octet>(writer, reader, Octet_type_info);
        return;

    case dcps::xtypes::TK_INT16:
        copyValue<Short>(writer, reader, Short_type_info);
        return;
    case dcps::xtypes::TK_UINT16:
        copyValue<UShort>(writer, reader, UShort_type_info);
        return;
    case dcps::xtypes::TK_CHAR16:
        copyValue<Char16>(writer, reader, Char16_type_info);
        return;

    case dcps::xtypes::TK_INT32:
        copyValue<Long>(writer, reader, Long_type_info);
        return;
    case dcps::xtypes::TK_UINT32:
        copyValue<ULong>(writer, reader, ULong_type_info);
        return;
    case dcps::xtypes::TK_FLOAT32:
        copyValue<Float>(writer, reader, Float_type_info);
        return;

    case dcps::xtypes::TK_INT64:
        copyValue<LongLong>(writer, reader, LongLong_type_info);
        return;
    case dcps::xtypes::TK_UINT64:
        copyValue<ULongLong>(writer, reader, ULongLong_type_info);
        return;
    case dcps::xtypes::TK_FLOAT64:
        copyValue<Double>(writer, reader, Double_type_info);
        return;
    default:
        break;
    };

    // Complex types
    writer.begin_type(type_info);
    reader.begin_type(type_info);
    switch (type_info.kind) {
    case dcps::xtypes::TK_BITSET:
    case dcps::xtypes::TK_BITMASK:
    case dcps::xtypes::TK_ENUM:
        copyPrimitive(writer, reader, type_info);
        break;

    case dcps::xtypes::TK_ALIAS:
        transform(writer, reader, *type_info.element_type);
        break;

    case dcps::xtypes::TK_ARRAY:
        for (ULong i = 0; i < type_info.max_length; ++i) {
            transform(writer, reader, *type_info.element_type);
        }
        break;

    case dcps::xtypes::TK_UNION:
        copyUnion(writer, reader, type_info);
        break;

    case dcps::xtypes::TK_STRUCTURE:
        copyStruct(writer, reader, type_info);
        break;

    case dcps::xtypes::TK_STRING8:
        copyString8(writer, reader, type_info);
        break;

    case dcps::xtypes::TK_STRING16:
        copyString16(writer, reader, type_info);
        break;

    case dcps::xtypes::TK_MAP:
        copyMap(writer, reader, type_info);
        break;

    case dcps::xtypes::TK_SEQUENCE:
        copySequence(writer, reader, type_info);
        break;

    case dcps::xtypes::TK_NONE:
    default:
        break;
    }
    reader.end_type();
    writer.end_type();
}

}  // namespace dcps::cts
}  // namespace intercom

#ifdef INTERCOM_COMPILER_MICROSOFT
#  pragma warning(pop)
#endif
