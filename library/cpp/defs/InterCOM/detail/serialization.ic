template <typename READER, typename UNMARSHAL>
inline TGenericUnmarshalBase<READER, UNMARSHAL>::StructValue::StructValue(
    UNMARSHAL& a_unmarshal,
    const TypeInfo* a_info
)
    : m_unmarshal(a_unmarshal), m_type_info(a_info ? *a_info : NULL_TYPE_INFO) {
    m_unmarshal.reader().begin_type(m_type_info);
}

template <typename READER, typename UNMARSHAL>
inline TGenericUnmarshalBase<READER, UNMARSHAL>::StructValue::~StructValue() {
    try {
        m_unmarshal.reader().end_type();
    } catch (...) {  // NOLINT
        // If the data is bad, we are probably already in an exception, so
        // propagating another from here will cause the application to terminate
    }
}

template <typename READER, typename UNMARSHAL>
template <typename T>
inline void TGenericUnmarshalBase<READER, UNMARSHAL>::StructValue::io(
    const MemberInfo& a_member_info,
    T& value
) {
    if (skip_member(a_member_info)) {
        return;
    }
    if (m_unmarshal.reader().find_member(a_member_info)) {
        Serializer<UNMARSHAL, T> serialize;
        serialize(m_unmarshal, value, a_member_info.type);
        m_unmarshal.reader().end_member();
    } else if ((m_unmarshal.reader().flags() & SERIALIZER_SKIP_MISSING) == 0) {
        if (a_member_info.default_value) {
            JsonReader reader(
                a_member_info.default_value,
                static_cast<uint32_t>(strlen(a_member_info.default_value))
            );
            dcps::cts::GenericUnmarshal(reader).io(value);
        } else {
            EmptyUnmarshal empty;
            Serializer<EmptyUnmarshal, T> serialize;
            serialize(empty, value, a_member_info.type);
        }
    }
}

template <typename READER, typename UNMARSHAL>
template <typename T>
inline void TGenericUnmarshalBase<READER, UNMARSHAL>::StructValue::io(
    const MemberInfo& a_member_info,
    std::optional<T>& value
) {
    if (skip_member(a_member_info)) {
        return;
    }
    if (m_unmarshal.reader().find_member(a_member_info)) {
        Serializer<UNMARSHAL, T> serialize;
        if (!value.has_value()) {
            value = T();
        }
        try {
            serialize(m_unmarshal, *value, a_member_info.type);
        } catch (std::runtime_error&) {
            value.reset();
        }
        m_unmarshal.reader().end_member();
    } else {
        value.reset();
    }
}

template <typename READER, typename UNMARSHAL>
template <typename T>
inline void TGenericUnmarshalBase<READER, UNMARSHAL>::io(T& value, const TypeInfo* a_type_info) {
    Serializer<UNMARSHAL, T> serialize;
    serialize(*static_cast<UNMARSHAL*>(this), value, a_type_info);
}

template <typename WRITER, typename MARSHAL>
template <typename T>
inline void TGenericMarshalBase<WRITER, MARSHAL>::io(const T& value, const TypeInfo* a_type_info) {
    Serializer<MARSHAL, T> serialize;
    serialize(*static_cast<MARSHAL*>(this), *const_cast<T*>(&value), a_type_info);
}

template <typename T, typename WRITER, typename READER>
inline T copy_value(WRITER& writer, READER& reader, const TypeInfo& type_info) {
    T value = 0;
    reader.read(&value, 1, type_info);
    writer.write(&value, 1, type_info);
    return value;
}

template <typename WRITER, typename READER>
inline uint64_t copy_primitive(WRITER& writer, READER& reader, const TypeInfo& type_info) {
    if (type_info.bit_size == 0 || type_info.bit_size > 64) {
        throw std::runtime_error("Invalid primitive size");
    }
    if (type_info.bit_size <= 8) {
        return copy_value<uint8_t>(writer, reader, type_info);
    }
    if (type_info.bit_size <= 16) {
        return copy_value<uint16_t>(writer, reader, type_info);
    }
    if (type_info.bit_size <= 32) {
        return copy_value<uint32_t>(writer, reader, type_info);
    }
    return copy_value<uint64_t>(writer, reader, type_info);
}

template <typename WRITER, typename READER>
inline bool
copy_discriminator(WRITER& writer, READER& reader, const TypeInfo& type_info, int32_t& a_idx) {
    const MemberInfo* member_info = &type_info.members[0];
    uint64_t discr = 0;
    bool reader_has_member = reader.find_member(*member_info);
    if (reader_has_member) {
        if (writer.begin_member(*member_info)) {
            discr = copy_primitive(writer, reader, *member_info->type);
            writer.end_member();
        } else {
            EmptyWriter empty_writer;
            discr = copy_primitive(empty_writer, reader, *member_info->type);
        }
        reader.end_member();
    } else {
        discr = type_info.member_count != 0 ? type_info.members[1].case_labels[0] : 0;
        for (uint32_t i = 1; i < type_info.member_count; ++i) {
            if ((type_info.members[i].flags & dcps::xtypes::IS_DEFAULT) != 0) {
                discr = type_info.members[i].case_labels[0];
                break;
            }
        }
        if (writer.begin_member(*member_info)) {
            if (type_info.bit_size == 0 || type_info.bit_size > 64) {
                throw std::runtime_error("Invalid primitive size");
            }
            if (type_info.bit_size <= 8) {
                auto value = static_cast<uint8_t>(discr);
                writer.write(&value, 1, type_info);
            } else if (type_info.bit_size <= 16) {
                auto value = static_cast<uint16_t>(discr);
                writer.write(&value, 1, type_info);
            } else if (type_info.bit_size <= 32) {
                auto value = static_cast<uint32_t>(discr);
                writer.write(&value, 1, type_info);
            } else {
                auto value = discr;
                writer.write(&value, 1, type_info);
            }
            writer.end_member();
        }
    }
    int default_member = 0;
    a_idx = 0;
    for (uint32_t i = 1; a_idx == 0 && i < type_info.member_count; ++i) {
        if ((type_info.members[i].flags & dcps::xtypes::IS_DEFAULT) != 0) {
            default_member = i;
        }
        for (int32_t j = 0; j < type_info.members[i].case_labels[0]; ++j) {
            if (discr == static_cast<uint64_t>(type_info.members[i].case_labels[j + 1])) {
                a_idx = i;
                break;
            }
        }
    }
    if (a_idx == 0 && default_member > 0) {
        a_idx = default_member;
    }
    return reader_has_member;
}

template <typename WRITER, typename READER>
inline void copy_member(WRITER& writer, READER& reader, const MemberInfo& member_info) {
    const bool is_optional = (member_info.flags & dcps::xtypes::IS_OPTIONAL) != 0;

    if (reader.find_member(member_info)) {
        bool copied = false;
        if (is_optional) {
            if (writer.begin_optional_member(member_info, true)) {
                transform(writer, reader, *member_info.type);
                writer.end_member();
                copied = true;
            }
        } else {
            if (writer.begin_member(member_info)) {
                transform(writer, reader, *member_info.type);
                writer.end_member();
                copied = true;
            }
        }
        if (!copied && !reader.can_skip_type()) {
            intercom::dcps::cts::EmptyWriter empty_writer;
            empty_writer.begin_member(member_info);
            transform(empty_writer, reader, *member_info.type);
            empty_writer.end_member();
        }
        reader.end_member();
    } else {
        if (is_optional) {
            if (writer.begin_optional_member(member_info, false)) {
                writer.end_member();
            }
        } else {
            if (writer.begin_member(member_info)) {
                if (member_info.default_value) {
                    JsonReader json_reader(
                        member_info.default_value,
                        static_cast<uint32_t>(strlen(member_info.default_value))
                    );
                    transform(writer, json_reader, *member_info.type);
                } else {
                    intercom::dcps::cts::EmptyReader empty_reader;
                    transform(writer, empty_reader, *member_info.type);
                }
                writer.end_member();
            }
        }
    }
}

template <typename WRITER, typename READER>
inline void copy_union(WRITER& writer, READER& reader, const TypeInfo& type_info) {
    int32_t idx;
    bool reader_has_value = copy_discriminator(writer, reader, type_info, idx);
    if (idx > 0) {
        if (reader_has_value) {
            copy_member(writer, reader, type_info.members[idx]);
        } else {
            EmptyReader empty_reader(false);
            copy_member(writer, empty_reader, type_info.members[idx]);
        }
    }
}

template <typename WRITER, typename READER>
inline void copy_struct(WRITER& writer, READER& reader, const TypeInfo& type_info) {
    uint32_t last_member = type_info.member_count;
    if (reader.type_level() <= 1 && writer.type_level() <= 1) {
        while (last_member > 0 && !writer.is_relevant(type_info.members[last_member - 1])) {
            --last_member;
        }
    }
    for (uint32_t i = 0; i < last_member; ++i) {
        copy_member(writer, reader, type_info.members[i]);
    }
}

template <typename WRITER, typename READER>
inline void copy_string8(WRITER& writer, READER& reader, const TypeInfo&) {
    std::string str;
    reader.read(str);
    writer.write(str);
}

template <typename WRITER, typename READER>
inline void copy_string16(WRITER& writer, READER& reader, const TypeInfo&) {
    std::wstring str;
    reader.read(str);
    writer.write(str);
}

template <typename WRITER, typename READER>
inline void copy_map(WRITER& writer, READER& reader, const TypeInfo& type_info) {
    auto length = reader.read_length();
    writer.write_length(length);
    for (uint32_t i = 0; i < length; ++i) {
        transform(writer, reader, *type_info.key_type);
        transform(writer, reader, *type_info.element_type);
    }
}

template <typename WRITER, typename READER>
inline void copy_sequence(WRITER& writer, READER& reader, const TypeInfo& type_info) {
    auto length = reader.read_length();
    writer.write_length(length);
    for (uint32_t i = 0; i < length; ++i) {
        transform(writer, reader, *type_info.element_type);
    }
}

template <typename T, typename WRITER, typename READER>
inline void transform(WRITER& writer, READER& reader) {
    transform(writer, reader, TypeTraits<T>::type_info);
}

template <typename WRITER, typename READER>
inline void transform(WRITER& writer, READER& reader, const TypeInfo& type_info) {
    // Primitive types are handle without begin_type/end_type
    switch (type_info.kind) {
    case dcps::xtypes::TK_BOOLEAN:
        copy_value<bool>(writer, reader, BOOLEAN_TYPE_INFO);
        return;
    case dcps::xtypes::TK_BYTE:
        copy_value<uint8_t>(writer, reader, OCTET_TYPE_INFO);
        return;
    case dcps::xtypes::TK_CHAR8:
        copy_value<char>(writer, reader, CHAR_TYPE_INFO);
        return;
    case dcps::xtypes::TK_INT8:
        copy_value<int8_t>(writer, reader, INT8_TYPE_INFO);
        return;
    case dcps::xtypes::TK_UINT8:
        copy_value<uint8_t>(writer, reader, OCTET_TYPE_INFO);
        return;

    case dcps::xtypes::TK_INT16:
        copy_value<int16_t>(writer, reader, SHORT_TYPE_INFO);
        return;
    case dcps::xtypes::TK_UINT16:
        copy_value<uint16_t>(writer, reader, USHORT_TYPE_INFO);
        return;
    case dcps::xtypes::TK_CHAR16:
        copy_value<char16_t>(writer, reader, CHAR16_TYPE_INFO);
        return;

    case dcps::xtypes::TK_INT32:
        copy_value<int32_t>(writer, reader, LONG_TYPE_INFO);
        return;
    case dcps::xtypes::TK_UINT32:
        copy_value<uint32_t>(writer, reader, ULONG_TYPE_INFO);
        return;
    case dcps::xtypes::TK_FLOAT32:
        copy_value<float>(writer, reader, FLOAT_TYPE_INFO);
        return;

    case dcps::xtypes::TK_INT64:
        copy_value<int64_t>(writer, reader, LONGLONG_TYPE_INFO);
        return;
    case dcps::xtypes::TK_UINT64:
        copy_value<uint64_t>(writer, reader, ULONGLONG_TYPE_INFO);
        return;
    case dcps::xtypes::TK_FLOAT64:
        copy_value<double>(writer, reader, DOUBLE_TYPE_INFO);
        return;
    default:
        break;
    };

    // Complex types
    writer.begin_type(type_info);
    reader.begin_type(type_info);
    switch (type_info.kind) {
    case dcps::xtypes::TK_BITSET:
    case dcps::xtypes::TK_BITMASK:
    case dcps::xtypes::TK_ENUM:
        copy_primitive(writer, reader, type_info);
        break;

    case dcps::xtypes::TK_ALIAS:
        transform(writer, reader, *type_info.element_type);
        break;

    case dcps::xtypes::TK_ARRAY:
        for (uint32_t i = 0; i < type_info.max_length; ++i) {
            transform(writer, reader, *type_info.element_type);
        }
        break;

    case dcps::xtypes::TK_UNION:
        copy_union(writer, reader, type_info);
        break;

    case dcps::xtypes::TK_STRUCTURE:
        copy_struct(writer, reader, type_info);
        break;

    case dcps::xtypes::TK_STRING8:
        copy_string8(writer, reader, type_info);
        break;

    case dcps::xtypes::TK_STRING16:
        copy_string16(writer, reader, type_info);
        break;

    case dcps::xtypes::TK_MAP:
        copy_map(writer, reader, type_info);
        break;

    case dcps::xtypes::TK_SEQUENCE:
        copy_sequence(writer, reader, type_info);
        break;

    case dcps::xtypes::TK_NONE:
    default:
        break;
    }
    reader.end_type();
    writer.end_type();
}

}  // namespace dcps::cts
}  // namespace intercom

#ifdef INTERCOM_COMPILER_MICROSOFT
#  pragma warning(pop)
#endif
