template <class Archive, typename T, size_t N>
struct Serializer<Archive, std::array<T, N>> {
    void operator()(Archive& a, std::array<T, N>& value, const TypeInfo* type_info) {
        typename Archive::template VectorValue<T> serializer(a, type_info);
        serializer.io(value.data(), static_cast<uint32_t>(N));
    }
};

template <class Archive, typename T>
struct Serializer<Archive, intercom::span<T>> {
    void operator()(Archive& a, intercom::span<T>& value, const TypeInfo* type_info) {
        typename Archive::template VectorValue<T> serializer(a, type_info);
        serializer.io(value.data(), static_cast<uint32_t>(value.size()));
    }
};

