        serializer.io(value.data(), static_cast<ULong>(value.size()));
    }
};

// vector<bool> is special, but should be serialized as a sequence of bytes
template <class Archive>
struct Serializer<Archive, std::vector<bool>> {
    void operator()(Archive& a, std::vector<bool>& value, const TypeInfo* type_info) {
        typename Archive::template VectorValue<Boolean> serializer(a, type_info);
        corba::Sequence<Boolean> copy;
        if (Archive::IS_WRITER) {
            copy.reserve(static_cast<ULong>(value.size()));
            for (auto elem : value) {
                copy.push_back(elem != 0);
            }
        }
        serializer.io(copy);
        if (Archive::IS_READER) {
            value.clear();
            value.reserve(copy.size());
            for (auto elem : copy) {
                value.push_back(elem != 0);
            }
        }
        if (type_info && type_info->max_length > 0 && value.size() > type_info->max_length) {
            if (type_info->flags & dcps::xtypes::IS_TRIM_TRY_CONSTRUCT) {
                value.resize(type_info->max_length);
            } else if (type_info->flags & dcps::xtypes::IS_USE_DEFAULT_TRY_CONSTRUCT) {
                value.clear();
            } else {
                throw std::runtime_error("Sequence length out of bounds in vector serializer");
            }
        }
    }
};

