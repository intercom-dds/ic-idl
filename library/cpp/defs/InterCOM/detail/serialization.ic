};

template <typename Archive, typename K, typename V, ULong N>
struct Serializer<Archive, bounded_map<K, V, N>> {
    void operator()(Archive& a, std::map<K, V>& value, const TypeInfo* type_info) {
        Serializer<Archive, std::map<K, V>> serializer;
        serializer(a, value, type_info);
    }
};

// Use pair of pointers here because gcc <= 4.3 gets confused by pair of references
template <typename Archive, typename K, typename V, typename Allocator>
struct Serializer<
    Archive,
    std::pair<corba::Sequence<K, Allocator>*, corba::Sequence<V, Allocator>*>> {
    void operator()(
        Archive& a,
        std::pair<corba::Sequence<K, Allocator>*, corba::Sequence<V, Allocator>*>& value,
        const TypeInfo* type_info
    ) {
        typename Archive::template MapValue<K, V> serializer(a, type_info);
        serializer.io(*value.first, *value.second);
        if (type_info && type_info->max_length > 0 && value.first->size() > type_info->max_length) {
            throw std::runtime_error("Map length out of bounds");
        }
        if (value.first->size() != value.second->size()) {
            throw std::runtime_error("Map key and value length inconsistent");
        }
    }
};

template <typename Archive, typename K, typename V, typename Alloc>
struct Serializer<Archive, std::pair<std::vector<K, Alloc>*, std::vector<V, Alloc>*>> {
    void operator()(
        Archive& a,
        std::pair<std::vector<K, Alloc>*, std::vector<V, Alloc>*>& value,
        const TypeInfo* type_info
    ) {
        typename Archive::template MapValue<K, V> serializer(a, type_info);
        serializer.io(*value.first, *value.second);
        if (type_info && type_info->max_length > 0 && value.first->size() > type_info->max_length) {
            throw std::runtime_error("Map length out of bounds");
        }
        if (value.first->size() != value.second->size()) {
            throw std::runtime_error("Map key and value length inconsistent");
        }
    }
};

template <typename Archive>
struct Serializer<Archive, std::vector<bool>::reference> {
    void operator()(Archive& a, std::vector<bool>::reference value, const TypeInfo* type_info) {
        bool copy = value;
        a.primitive_io(copy, type_info);
        value = copy;
    }
};

