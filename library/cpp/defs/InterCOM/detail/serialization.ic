template <class Archive>
struct Serializer<Archive, std::wstring> {
    void operator()(Archive& a, std::wstring& value, const TypeInfo* type_info) {
        typename Archive::template StringValue<encoding_type_of<std::wstring::value_type>::kind>
            serializer(a, type_info);
        serializer.io(value);
        if (type_info && type_info->max_length > 0 && value.size() > type_info->max_length) {
            if (type_info->flags & dcps::xtypes::IS_TRIM_TRY_CONSTRUCT) {
                value.reserve(type_info->max_length);
            } else if (type_info->flags & dcps::xtypes::IS_USE_DEFAULT_TRY_CONSTRUCT) {
                if (type_info->default_value) {
                    value = static_cast<std::wstring::value_type*>(type_info->default_value);
                } else {
                    value.clear();
                }
            } else {
                throw std::runtime_error("String length out of bounds");
            }
        }
    }
};

template <class Archive, typename T, typename Alloc>
struct Serializer<Archive, std::vector<T, Alloc>> {
    void operator()(Archive& a, std::vector<T, Alloc>& value, const TypeInfo* type_info) {
        typename Archive::template VectorValue<T> serializer(a, type_info);
        serializer.io(value);
        if (type_info && type_info->max_length > 0 && value.size() > type_info->max_length) {
            if (type_info->flags & dcps::xtypes::IS_TRIM_TRY_CONSTRUCT) {
                value.resize(type_info->max_length);
            } else if (type_info->flags & dcps::xtypes::IS_USE_DEFAULT_TRY_CONSTRUCT) {
                value.clear();
            } else {
                throw std::runtime_error("Sequence length out of bounds in vector serializer");
            }
        }
    }
};

template <class Archive, typename T, uint32_t L>
struct Serializer<Archive, bounded_vector<T, L>> {
    void operator()(Archive& a, std::vector<T>& value, const TypeInfo* type_info) {
        Serializer<Archive, std::vector<T>> serializer;
        serializer(a, value, type_info);
    }
};

template <typename Archive, typename K, typename V, typename Comparator, typename Allocator>
struct Serializer<Archive, std::map<K, V, Comparator, Allocator>> {
    void operator()(
        Archive& a,
        std::map<K, V, Comparator, Allocator>& value,
        const TypeInfo* type_info
    ) {
        typename Archive::template MapValue<K, V> serializer(a, type_info);
        serializer.io(value);
        if (type_info && type_info->max_length > 0 && value.size() > type_info->max_length) {
            if (type_info->flags & dcps::xtypes::IS_USE_DEFAULT_TRY_CONSTRUCT) {
                value.clear();
            } else {
                throw std::runtime_error("Map length out of bounds");
            }
        }
    }
};

template <typename Archive, typename K, typename V, uint32_t N>
struct Serializer<Archive, bounded_map<K, V, N>> {
    void operator()(Archive& a, std::map<K, V>& value, const TypeInfo* type_info) {
        Serializer<Archive, std::map<K, V>> serializer;
        serializer(a, value, type_info);
    }
};

template <typename Archive, typename K, typename V, typename Alloc>
struct Serializer<Archive, std::pair<std::vector<K, Alloc>*, std::vector<V, Alloc>*>> {
    void operator()(
        Archive& a,
        std::pair<std::vector<K, Alloc>*, std::vector<V, Alloc>*>& value,
        const TypeInfo* type_info
    ) {
        typename Archive::template MapValue<K, V> serializer(a, type_info);
        serializer.io(*value.first, *value.second);
        if (type_info && type_info->max_length > 0 && value.first->size() > type_info->max_length) {
            throw std::runtime_error("Map length out of bounds");
        }
        if (value.first->size() != value.second->size()) {
            throw std::runtime_error("Map key and value length inconsistent");
        }
    }
};

template <typename Archive>
struct Serializer<Archive, std::vector<bool>::reference> {
    void operator()(Archive& a, std::vector<bool>::reference value, const TypeInfo* type_info) {
        bool copy = value;
        a.primitive_io(copy, type_info);
        value = copy;
    }
};

