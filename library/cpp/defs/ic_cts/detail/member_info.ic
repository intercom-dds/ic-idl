inline constexpr const int32_t* const MEMBER_INFO_EMPTY_CASE_LABELS = {nullptr};

inline constexpr const TypeInfo TypeTraits<bool>::type_info = BOOLEAN_TYPE_INFO;
inline constexpr const TypeInfo TypeTraits<char>::type_info = CHAR_TYPE_INFO;
inline constexpr const TypeInfo TypeTraits<char16_t>::type_info = CHAR16_TYPE_INFO;
inline constexpr const TypeInfo TypeTraits<int8_t>::type_info = INT8_TYPE_INFO;
inline constexpr const TypeInfo TypeTraits<uint8_t>::type_info = UINT8_TYPE_INFO;
inline constexpr const TypeInfo TypeTraits<int16_t>::type_info = SHORT_TYPE_INFO;
inline constexpr const TypeInfo TypeTraits<uint16_t>::type_info = USHORT_TYPE_INFO;
inline constexpr const TypeInfo TypeTraits<int32_t>::type_info = LONG_TYPE_INFO;
inline constexpr const TypeInfo TypeTraits<uint32_t>::type_info = ULONG_TYPE_INFO;
inline constexpr const TypeInfo TypeTraits<int64_t>::type_info = LONGLONG_TYPE_INFO;
inline constexpr const TypeInfo TypeTraits<uint64_t>::type_info = ULONGLONG_TYPE_INFO;
inline constexpr const TypeInfo TypeTraits<float>::type_info = FLOAT_TYPE_INFO;
inline constexpr const TypeInfo TypeTraits<double>::type_info = DOUBLE_TYPE_INFO;
inline constexpr const TypeInfo TypeTraits<long double>::type_info = LONG_DOUBLE_TYPE_INFO;

}  // namespace ic_cts
