module bounds {
    @nested
    struct MinType {
        @min(0) int8 min_i8;
        @min(128) uint16 min_u16;
        @min(1024) uint32 min_u32;
        @min(4096) int64 min_i64;
    };

    @nested
    struct MaxType {
        @max(0) int8 max_i8;
        @max(128) uint16 max_u16;
        @max(1024) uint32 max_u32;
        @max(4096) int64 max_i64;
    };

    @nested
    struct BoundedCollections {
        sequence<int32, 3> bounded_seq;
        map<string, string, 3> bounded_map;
        string<3> bounded_str;
        wstring<3> bounded_wstr;
    };

    @nested
    struct RangedType {
        @range(min=0, max=10) int8 range_i8;
        @range(min=128, max=1024) uint16 range_u16;
        @range(min=1024, max=4095) uint32 range_u32;
        @range(min=4096, max=8192) int64 range_i64;
    };
};

module not_zero {
    enum ZeroInvalidEnum {
        NINE = 9,
        TEN
    };

    struct ZeroInvalid {
        @range(min=10, max=55) int64 my_int;
        ZeroInvalidEnum my_enum;
    };

    struct KeyedZeroInvalid {
        @key @range(min=10, max=55) int64 my_int;
        @key ZeroInvalidEnum my_enum;
    };
};
