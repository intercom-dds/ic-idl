#pragma once

module precedence {
    // `FooBar` and `FooBar_` already exist, so this should be renamed to `FooBar__`
    struct foo_bar {
        boolean double_underscore;
    };

    // `FooBar`, `FooBar_` and `FooBar__` exist, so this should be `FooBar___`
    struct foo_bar_t {
        boolean triple_underscore;
    };

    // The underscore would typically be stripped, but since `FooBar` already
    // exists, this node gets to keep its original name.
    struct FooBar_ {
        boolean single_underscore;
    };

    // Defined last but still gets precedence over all the other nodes, so the
    // name remains unaltered.
    struct FooBar {
        boolean unaltered;
    };
};

module substitute {
    // Renamed to `FooBar`
    struct FooBar_ {};

    // `FooBar_` was renamed to `FooBar`, so this can take its place
    struct FooBar__ {
        boolean single_underscore;
    };

    // Similarly, `FooBar__` is now available so we use that
    struct FooBar___ {
        boolean double_underscore;
    };
};

module mod_collision {
    module my_module {
        struct Foo {
            boolean unaltered;
        };
    };

    // Becomes "my_module_"
    module MyModule {
        struct Foo {};
    };

    // Becomes `Property`, which is fine because the module later becomes `property`
    struct property_t {};

    // Becomes `property` which frees up the `Property` name
    module Property {
        struct Foo {};
    };
};

module moved_node {
    // `Bar` will be moved to a module called `foo_bar`, which creates a
    // collision with the existing `foo_bar::Bar` type.
    interface FooBar {
        struct Bar {
            boolean single_underscore;
        };
    };

    module foo_bar {
        struct Bar {};
    };
};
