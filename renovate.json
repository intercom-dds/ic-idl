{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":disableDependencyDashboard"],
  "enabledManagers": ["cargo"],
  "lockFileMaintenance": {
    "enabled": false
  },
  "platformAutomerge": true,
  "automergeType": "pr",
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "groupName": "all cargo dependencies",
      "automerge": true,
      "rangeStrategy": "bump"
    }
  ]
}
