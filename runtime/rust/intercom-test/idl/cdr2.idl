#pragma once

module cdr2 {
module final {
    @final
    struct PrimitiveStruct {
        @default(128) uint8 value1;
        @default(128) uint16 value2;
        @default(128) uint32 value3;
        @default(128) uint64 value4;
        @default(1.5) float value5;
        @default(1.5) double value6;
    };

    @final
    struct SixtyFourAlign {
        @default(128) uint8 value1;
        @default(128) uint64 value4;
    };

    const octet PRIMITIVE_STRUCT_EXPECTED[28] = {
        128, 0, 128, 0, 128, 0, 0, 0, 128, 0, 0, 0, 0, 0, 0, 0, 0, 0, 192, 63,
        0, 0, 0, 0, 0, 0, 248, 63
    };

    @final
    struct PrimitiveArray {
        @default({1, 2, 3})
        int32 my_array[3];
    };

    const octet PRIMITIVE_ARRAY_TYPE_EXPECTED[12] = {
        1, 0, 0, 0,
        2, 0, 0, 0,
        3, 0, 0, 0
    };

    @final
    struct ArrayType {
        @default({"a", "b", "c"})
        string inner[3];
    };

    const octet ARRAY_TYPE_EXPECTED[26] = {
        22, 0, 0, 0, // dheader
        2,  0, 0, 0, // len of str
        97, 0, 0, 0, // 'a'
        2,  0, 0, 0, // len of str
        98, 0, 0, 0, // 'b'
        2,  0, 0, 0, // len of str
        99, 0        // 'c'
    };

    @final
    struct SeqType {
        @default({"a", "b", "c"})
        sequence<string> inner;
    };

    const octet SEQ_TYPE_EXPECTED[30] = {
        26, 0, 0, 0, // dheader
        3,  0, 0, 0, // len of seq
        2,  0, 0, 0, // len of str
        97, 0, 0, 0, // 'a'
        2,  0, 0, 0, // len of str
        98, 0, 0, 0, // 'b'
        2,  0, 0, 0, // len of str
        99, 0        // 'c'
    };

    @final
    struct PrimitiveSeqType {
        @default({1, 2, 3})
        sequence<int32> inner;
    };

    const octet PRIMITIVE_SEQ_TYPE_EXPECTED[16] = {
        3, 0, 0, 0,
        1, 0, 0, 0,
        2, 0, 0, 0,
        3, 0, 0, 0
    };

    @final
    struct MapType {
        @default({{1, "a"}, {2, "b"}, {3, "c"}})
        map<int32, string> inner;
    };

    const octet MAP_TYPE_EXPECTED[42] = {
        38, 0, 0, 0, // dheader
        3,  0, 0, 0, // len of map
        1,  0, 0, 0, // key 1
        2,  0, 0, 0, // len of value 1
        97, 0, 0, 0, // 'a' + padding
        2,  0, 0, 0, // key 2
        2,  0, 0, 0, // len of key 2
        98, 0, 0, 0, // 'b' + padding
        3,  0, 0, 0, // key 3
        2,  0, 0, 0, // len of key 3
        99, 0        // 'b'
    };

    @final
    struct PrimitiveMap {
        @default({{1, 1}, {2, 2}, {3, 333}})
        map<int32, int32> inner;
    };

    const octet PRIMITIVE_MAP_EXPECTED[28] = {
        3,  0, 0, 0, // len of map
        1,  0, 0, 0, // key 1
        1,  0, 0, 0, // value 1
        2,  0, 0, 0, // key 2
        2,  0, 0, 0, // value 2
        3,  0, 0, 0, // key 3
        77, 1, 0, 0  // value 3
    };

    @final
    struct OptionalMember {
        @id(9) @optional int32 is_null;
        @id(10) @optional int32 is_present;
    };

    const octet OPTIONAL_MEMBER_EXPECTED[8] = {
        0,    // not present
        1,    // present
        0, 0, // padding
        123, 0, 0, 0
    };
};

module appendable {
    @appendable
    struct PrimitiveStruct {
        @default(128) uint8 value1;
        @default(128) uint16 value2;
        @default(128) uint32 value3;
        @default(128) uint64 value4;
        @default(1.5) float value5;
        @default(1.5) double value6;
    };

    const octet PRIMITIVE_STRUCT_EXPECTED[32] = {
        28, 0, 0, 0, 128, 0, 128, 0, 128, 0, 0, 0, 128, 0, 0, 0, 0, 0, 0, 0, 0,
        0, 192, 63, 0, 0, 0, 0, 0, 0, 248, 63
    };

    @appendable
    struct ArrayType {
        @default({"a", "b", "c"})
        string inner[3];
    };

    const octet ARRAY_TYPE_EXPECTED[30] = {
        26, 0, 0, 0, 22, 0, 0, 0, 2, 0, 0, 0, 97, 0, 0, 0, 2, 0, 0, 0, 98, 0,
        0, 0, 2, 0, 0, 0, 99, 0
    };

    @appendable
    struct PrimitiveArray {
        @default({1, 2, 3})
        int32 my_array[3];
    };

    const octet PRIMITIVE_ARRAY_TYPE_EXPECTED[16] = {
        12, 0, 0, 0, 1, 0, 0, 0, 2, 0, 0, 0, 3, 0, 0, 0
    };

    @appendable
    struct SeqType {
        @default({"a", "b", "c"})
        sequence<string> inner;
    };

    const octet SEQ_TYPE_EXPECTED[34] = {
        30, 0, 0, 0,
        26, 0, 0, 0, // dheader
        3,  0, 0, 0, // len of seq
        2,  0, 0, 0, // len of str
        97, 0, 0, 0, // 'a'
        2,  0, 0, 0, // len of str
        98, 0, 0, 0, // 'b'
        2,  0, 0, 0, // len of str
        99, 0        // 'c'
    };

    @appendable
    struct PrimitiveSeqType {
        @default({1, 2, 3})
        sequence<int32> inner;
    };

    const octet PRIMITIVE_SEQ_TYPE_EXPECTED[20] = {
        16, 0, 0, 0,
        3,  0, 0, 0,
        1,  0, 0, 0,
        2,  0, 0, 0,
        3,  0, 0, 0
    };

    @appendable
    struct MapType {
        @default({{1, "a"}, {2, "b"}, {3, "c"}})
        map<int32, string> inner;
    };

    const octet MAP_TYPE_EXPECTED[46] = {
        42, 0, 0, 0, //
        38, 0, 0, 0, // dheader
        3,  0, 0, 0, // len of map
        1,  0, 0, 0, // key 1
        2,  0, 0, 0, // len of value 1
        97, 0, 0, 0, // 'a' + padding
        2,  0, 0, 0, // key 2
        2,  0, 0, 0, // len of key 2
        98, 0, 0, 0, // 'b' + padding
        3,  0, 0, 0, // key 3
        2,  0, 0, 0, // len of key 3
        99, 0        // 'b'
    };

    @appendable
    struct PrimitiveMap {
        @default({{1, 1}, {2, 2}, {3, 333}})
        map<int32, int32> inner;
    };

    const octet PRIMITIVE_MAP_EXPECTED[32] = {
        28, 0, 0, 0,
        3,  0, 0, 0, // len of map
        1,  0, 0, 0, // key 1
        1,  0, 0, 0, // value 1
        2,  0, 0, 0, // key 2
        2,  0, 0, 0, // value 2
        3,  0, 0, 0, // key 3
        77, 1, 0, 0  // value 3
    };

    @appendable
    struct OptionalMember {
        @id(9) @optional int32 is_null;
        @id(10) @optional int32 is_present;
    };

    const octet OPTIONAL_MEMBER_EXPECTED[12] = {
        8, 0, 0, 0, 0, 1, 0, 0, 123, 0, 0, 0
    };

    @appendable
    struct OptionalLongPlMember {
        @id(0x3f01) @optional int32 is_null;
        @id(0x203f05) @optional int32 is_present;
    };

    const octet OPTIONAL_LONG_PL_MEMBER[12] = OPTIONAL_MEMBER_EXPECTED;
};

module mutable {
    @mutable
    struct PrimitiveStruct {
        @default(255) uint8 value1;
        @default(128) uint16 value2;
        @default(128) uint32 value3;
        @default(128) uint64 value4;
        @default(1.5) float value5;
        @default(1.5) double value6;
    };

    const octet PRIMITIVE_STRUCT_EXPECTED[60] = {
        56, 0, 0, 0, 0, 0, 0, 0, 255, 0, 0, 0, 1, 0, 0, 16, 128, 0, 0, 0, 2, 0,
        0, 32, 128, 0, 0, 0, 3, 0, 0, 48, 128, 0, 0, 0, 0, 0, 0, 0, 4, 0, 0,
        32, 0, 0, 192, 63, 5, 0, 0, 48, 0, 0, 0, 0, 0, 0, 248, 63
    };

    @mutable
    struct ArrayType {
        @default({"a", "b", "c"})
        string inner[3];
    };

    const octet ARRAY_TYPE_EXPECTED[34] = {
        30, 0, 0, 0, 0, 0, 0, 80, 22, 0, 0, 0, 2, 0, 0, 0, 97, 0, 0, 0, 2, 0,
        0, 0, 98, 0, 0, 0, 2, 0, 0, 0, 99, 0
    };

    @mutable
    struct PrimitiveArray {
        @default({1, 2, 3})
        @id(5) int32 my_array[3];
    };

    const octet PRIMITIVE_ARRAY_TYPE_EXPECTED[24] = {
        20, 0, 0, 0, 5, 0, 0, 64, 12, 0, 0, 0, 1, 0, 0, 0, 2, 0, 0, 0, 3, 0, 0, 0
    };

    @mutable
    struct Array2D {
        @id(6) int32 my_array[10][10];
    };

    @mutable
    struct Array3D {
        @id(7) uint8 my_array[4][4][4];
    };

    @mutable
    struct SeqType {
        @default({"a", "b", "c"})
        sequence<string> inner;
    };

    const octet SEQ_TYPE_EXPECTED[38] = {
        34, 0, 0, 0, 0, 0, 0, 80, 26, 0, 0, 0, 3, 0, 0, 0, 2, 0, 0, 0, 97, 0,
        0, 0, 2, 0, 0, 0, 98, 0, 0, 0, 2, 0, 0, 0, 99, 0
    };

    @mutable
    struct PrimitiveSeqType {
        @default({1, 2, 3})
        sequence<int32> inner;
    };

    const octet PRIMITIVE_SEQ_TYPE_EXPECTED[24] = {
        20, 0, 0, 0, 0, 0, 0, 96, 3, 0, 0, 0, 1, 0, 0, 0, 2, 0, 0, 0, 3, 0, 0, 0
    };

    @mutable
    struct MapType {
        @default({{1, "a"}, {2, "b"}, {3, "c"}})
        map<int32, string> inner;
    };


    const octet MAP_TYPE_EXPECTED[50] = {
        46, 0, 0, 0, 0, 0, 0, 80, 38, 0, 0, 0, 3, 0, 0, 0, 1, 0, 0, 0, 2, 0, 0,
        0, 97, 0, 0, 0, 2, 0, 0, 0, 2, 0, 0, 0, 98, 0, 0, 0, 3, 0, 0, 0, 2, 0,
        0, 0, 99, 0
    };

    @mutable
    struct PrimitiveMapType {
        @default({{1, 1}, {2, 2}, {3, 333}})
        map<int32, int32> inner;
    };

    const octet PRIMITIVE_MAP_EXPECTED[40] = {
        36, 0, 0, 0, 0, 0, 0, 64, 28, 0, 0, 0, 3, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0,
        0, 2, 0, 0, 0, 2, 0, 0, 0, 3, 0, 0, 0, 77, 1, 0, 0
    };

    @mutable
    struct OptionalMember {
        @id(9) @optional int32 is_null;
        @id(10 )@optional int32 is_present;
    };

    const octet OPTIONAL_MEMBER_EXPECTED[12] = {
        8, 0, 0, 0, 10, 0, 0, 32, 123, 0, 0, 0
    };

    @mutable
    struct LongPlStruct {
        @id(0x3f01) octet value1;
        @id(0x3f03) int16 value3;
        @id(0x3f04) @must_understand octet value4;
        @id(0x203f04) octet value5;
        @id(0x203f05) @must_understand octet value6;
    };

    const octet LONG_PL_STRUCT_EXPECTED[41] = {
        37, 0, 0, 0, 1, 63, 0, 0, 0, 0, 0, 0, 3, 63, 0, 16, 0, 0, 0, 0, 4, 63,
        0, 128, 0, 0, 0, 0, 4, 63, 32, 0, 0, 0, 0, 0, 5, 63, 32, 128, 0
    };

    @mutable
    struct OptionalLongPlMember {
        @id(0x3f01) @optional int32 is_null;
        @id(0x203f05) @optional int32 is_present;
    };

    const octet OPTIONAL_LONG_PL_MEMBER[12] = {
        8, 0, 0, 0, 5, 63, 32, 32, 123, 0, 0, 0
    };

    @mutable
    union UnionType switch(int32) {
    case 0:
        string value1;
    default:
        int32 value2;
    };

    const octet UNION_TYPE_EXPECTED[24] = {
        20, 0, 0, 0, 0, 0, 0, 160, 0, 0, 0, 0, 1, 0, 0, 80, 4, 0, 0, 0, 102,
        111, 111, 0
    };
};

module mixed {
    @final
    struct TopFinal {
        final::PrimitiveStruct final_member;
        appendable::PrimitiveStruct appendable_member;
        mutable::PrimitiveStruct mutable_member;
    };

    const octet TOP_FINAL_EXPECTED[120] = {
        128, 0, 128, 0, 128, 0, 0, 0, 128, 0, 0, 0, 0, 0, 0, 0, 0, 0, 192, 63,
        0, 0, 0, 0, 0, 0, 248, 63, 28, 0, 0, 0, 128, 0, 128, 0, 128, 0, 0, 0,
        128, 0, 0, 0, 0, 0, 0, 0, 0, 0, 192, 63, 0, 0, 0, 0, 0, 0, 248, 63, 56,
        0, 0, 0, 0, 0, 0, 0, 255, 0, 0, 0, 1, 0, 0, 16, 128, 0, 0, 0, 2, 0, 0,
        32, 128, 0, 0, 0, 3, 0, 0, 48, 128, 0, 0, 0, 0, 0, 0, 0, 4, 0, 0, 32,
        0, 0, 192, 63, 5, 0, 0, 48, 0, 0, 0, 0, 0, 0, 248, 63
    };

    @appendable
    struct TopAppendable {
        final::PrimitiveStruct final_member;
        appendable::PrimitiveStruct appendable_member;
        mutable::PrimitiveStruct mutable_member;
    };

    const octet TOP_APPENDABLE_EXPECTED[124] = {
        120, 0, 0, 0, 128, 0, 128, 0, 128, 0, 0, 0, 128, 0, 0, 0, 0, 0, 0, 0,
        0, 0, 192, 63, 0, 0, 0, 0, 0, 0, 248, 63, 28, 0, 0, 0, 128, 0, 128, 0,
        128, 0, 0, 0, 128, 0, 0, 0, 0, 0, 0, 0, 0, 0, 192, 63, 0, 0, 0, 0, 0,
        0, 248, 63, 56, 0, 0, 0, 0, 0, 0, 0, 255, 0, 0, 0, 1, 0, 0, 16, 128, 0,
        0, 0, 2, 0, 0, 32, 128, 0, 0, 0, 3, 0, 0, 48, 128, 0, 0, 0, 0, 0, 0, 0,
        4, 0, 0, 32, 0, 0, 192, 63, 5, 0, 0, 48, 0, 0, 0, 0, 0, 0, 248, 63
    };

    @mutable
    struct TopMutable {
        final::PrimitiveStruct final_member;
        appendable::PrimitiveStruct appendable_member;
        mutable::PrimitiveStruct mutable_member;
    };

    const octet TOP_MUTABLE_EXPECTED[140] = {
        136, 0, 0, 0, 0, 0, 0, 64, 28, 0, 0, 0, 128, 0, 128, 0, 128, 0, 0, 0,
        128, 0, 0, 0, 0, 0, 0, 0, 0, 0, 192, 63, 0, 0, 0, 0, 0, 0, 248, 63, 1,
        0, 0, 80, 28, 0, 0, 0, 128, 0, 128, 0, 128, 0, 0, 0, 128, 0, 0, 0, 0,
        0, 0, 0, 0, 0, 192, 63, 0, 0, 0, 0, 0, 0, 248, 63, 2, 0, 0, 80, 56, 0,
        0, 0, 0, 0, 0, 0, 255, 0, 0, 0, 1, 0, 0, 16, 128, 0, 0, 0, 2, 0, 0, 32,
        128, 0, 0, 0, 3, 0, 0, 48, 128, 0, 0, 0, 0, 0, 0, 0, 4, 0, 0, 32, 0, 0,
        192, 63, 5, 0, 0, 48, 0, 0, 0, 0, 0, 0, 248, 63
    };

    struct EmptyMutable {};

    @final
    struct MutableMiddle {
        @id(4444) int32 value1;
        mutable::PrimitiveStruct value2;
        // validates that we restore the original encoding of `MutableMiddle`
        int32 value3;
    };

    const octet MUTABLE_MIDDLE_EXPECTED[68] = {
        0, 0, 0, 0, 56, 0, 0, 0, 0, 0, 0, 0, 255, 0, 0, 0, 1, 0, 0, 16, 128, 0,
        0, 0, 2, 0, 0, 32, 128, 0, 0, 0, 3, 0, 0, 48, 128, 0, 0, 0, 0, 0, 0, 0,
        4, 0, 0, 32, 0, 0, 192, 63, 5, 0, 0, 48, 0, 0, 0, 0, 0, 0, 248, 63, 0,
        0, 0, 0
    };

    @appendable
    struct AppendableGen1 {
        @default("foo") string value1;
    };

    @mutable
    struct MutableAppendableGen1 {
        AppendableGen1 value1;
        @default(99) int32 foobar;
    };

    @appendable
    struct AppendableGen2 {
        @default("foo") string value1;
        @default("bar") string value2;
    };

    @mutable
    struct MutableAppendableGen2 {
        AppendableGen2 value1;
        @default(99) int32 foobar;
    };
};
};
