const octet TK_NONE = 3;

enum MyEnum {
    MY_ENUM_ONE,
    MY_ENUM_TWO,
    MY_ENUM_NINE = 9
};

const MyEnum ENUM_CONSTANT = MyEnum::MY_ENUM_ONE;

union DefaultUnion switch (@default(ENUM_CONSTANT) MyEnum) {
case MY_ENUM_ONE:
    @shared @default("test") string my_str;
default:
    null;
};

@bit_bound(32)
bitmask BitmaskTest {
    BitmaskBitA = 23,
    BitmaskBitB,
    BitmaskBitC,
    @default_literal BitmaskBitD,
    BitmaskBitE
};

const BitmaskTest MY_BIT = BitmaskTest::BitmaskBitA;

@nested
struct WrapsBitmask {
    BitmaskTest value;
};

bitmask BitmaskAbc {
    FLAG_A = 1,
    FLAG_B = 2,
    FLAG_C = 4
};

module scoped {
    interface MyInterface {
        struct Foo {};

        struct Bar : Foo {};

        enum DeeplyNestedEnum {
            ONE = 1
        };

        bitmask MyBitmask {
            ZERO
        };

        exception MyException {};
    };

    struct Foo {};

    struct Bar {
        MyInterface::DeeplyNestedEnum my_foo;
    };

    const MyInterface::DeeplyNestedEnum DEEPLY_NESTED_CONST = MyInterface::DeeplyNestedEnum::ONE;

    const MyInterface::MyBitmask MY_BITMASK = MyInterface::MyBitmask::ZERO;
};

module label {
    enum CaseLabel {
        ZERO,
        ONE,
        TWO
    };

    union MultipleNull switch(CaseLabel) {
    case ZERO:
    case ONE:
        null;
    default:
        string var;
    };

    union MultipleDefault switch(CaseLabel) {
    case ZERO:
    case ONE:
    default:
        string var;
    };

    union MultipleNullOctet switch(octet) {
    case 0:
    case 1:
        null;
    default:
        string var;
    };

    union MultipleDefaultOctet switch(octet) {
    case 0:
    case 1:
    default:
        string var;
    };

    union AllLiteralsCovered switch(CaseLabel) {
    case ZERO:
        int32 my_int;
    case ONE:
        string my_str;
    case TWO:
        null;
    };
};
