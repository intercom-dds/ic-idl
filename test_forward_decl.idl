// Test forward declaration handling

// Simple forward declaration
struct Foo;

// Definition of forward declared type
struct Foo {
    long x;
};

// Forward declaration in module
module test {
    struct Bar;
    
    struct Bar {
        double y;
    };
}

// Single forward declaration
union Baz;

// Definition
union Baz switch (long) {
    case 0: long a;
    case 1: double b;
};