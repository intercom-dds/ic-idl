valuetype v1 {};

interface foo {};

valuetype value1 : v1 {};

valuetype value2 : ::v1 {};

valuetype value3 supports foo {};

valuetype value4 : v1 supports ::foo {};

valuetype value5 {
    attribute string value;
};

valuetype value6 : value5 {
    void op1();
    string op1(in string value);
};

// Example demonstrating grammar rule 100: <value_def>
// <value_def> ::= <value_header> "{" <value_element>* "}"

// First, let's define some types and exceptions we'll use
exception InvalidStateException {
    string reason;
};

exception FactoryException {
    long error_code;
    string message;
};

// Base valuetype to inherit from
valuetype BaseValue {
    // State members (rule 106)
    public string base_name;
    private long internal_id;
};

// Interface to support
interface Printable {
    string toString();
    void print();
};

// Complex valuetype demonstrating all features (rule 100)
valuetype ComplexValue : BaseValue supports Printable {
    // === State Members (rule 106) ===
    public double price;
    public boolean active;
    private sequence<string> internal_data;

    // === Exports (rule 97) ===

    // Type declarations (rule 20)
    struct Metadata {
        string key;
        string value;
    };

    enum Status {
        PENDING,
        ACTIVE,
        SUSPENDED,
        TERMINATED
    };

    typedef sequence<Metadata> MetadataList;

    // Constant declarations (rule 5)
    const long MAX_RETRIES = 3;
    const string DEFAULT_PREFIX = "VAL_";

    // Exception declaration (rule 72)
    exception ValidationException {
        string field_name;
        string error_message;
    };

    // === Operations (rule 82) ===
    void initialize(in string name, in double initial_price)
        raises (InvalidStateException);

    MetadataList getMetadata();

    boolean updateStatus(in Status new_status)
        raises (ValidationException, InvalidStateException);

    // === Attributes (rule 88) ===
    readonly attribute string identifier;
    readonly attribute Status current_status;
    attribute MetadataList metadata;
};

// Another example showing minimal valuetype
valuetype SimpleValue {
    public string value;
};
